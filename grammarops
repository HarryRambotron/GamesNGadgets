<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Word Ops — Word Skills Mission Control</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-deep:#12132b;
    --bg-panel:#1c1e42;
    --bg-panel-light:#262a52;
    --accent-yellow:#ffd23f;
    --accent-coral:#ff6b6b;
    --accent-teal:#4ecdc4;
    --accent-blue:#5b9df9;
    --accent-green:#5fd48a;
    --accent-purple:#b388ff;
    --accent-orange:#ff9f40;
    --text-light:#f4f2ec;
    --text-dim:#a8abd6;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; min-height:100%;
    background:var(--bg-deep);
    color:var(--text-light);
    font-family:'Nunito',sans-serif;
    -webkit-tap-highlight-color:transparent;
  }
  #starfield{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,.35) 0%, transparent 60%),
      radial-gradient(2px 2px at 70% 65%, rgba(255,255,255,.25) 0%, transparent 60%),
      radial-gradient(1.5px 1.5px at 85% 20%, rgba(255,255,255,.3) 0%, transparent 60%),
      radial-gradient(1.5px 1.5px at 40% 80%, rgba(255,255,255,.25) 0%, transparent 60%),
      radial-gradient(1.5px 1.5px at 55% 15%, rgba(255,255,255,.2) 0%, transparent 60%),
      radial-gradient(1.5px 1.5px at 10% 75%, rgba(255,255,255,.2) 0%, transparent 60%);
    background-size:100% 100%;
    animation:twinkle 4s ease-in-out infinite alternate;
  }
  @keyframes twinkle{ from{opacity:.5;} to{opacity:1;} }
  #app{
    position:relative; z-index:1;
    min-height:100vh; width:100%;
    display:flex; align-items:center; justify-content:center;
    padding:24px;
  }
  .screen{ width:100%; max-width:760px; text-align:center; }
  .hidden{ display:none !important; }

  .logo{
    font-family:'Press Start 2P', monospace;
    font-size:clamp(1rem, 3vw, 1.6rem);
    color:var(--accent-yellow);
    letter-spacing:2px;
    text-shadow:0 0 18px rgba(255,210,63,.5);
    margin-bottom:6px;
  }
  .tagline{ color:var(--text-dim); font-weight:700; margin-bottom:28px; font-size:1.05rem;}

  .panel{
    background:var(--bg-panel);
    border-radius:24px;
    padding:32px 28px;
    box-shadow:0 20px 50px rgba(0,0,0,.4), inset 0 0 0 2px rgba(255,255,255,.04);
  }

  .name-field{
    display:flex; align-items:center; gap:10px;
    background:var(--bg-panel-light);
    border-radius:14px;
    padding:8px 8px 8px 18px;
    margin:0 0 22px;
  }
  .name-field label{ font-weight:800; color:var(--text-dim); font-size:.95rem; white-space:nowrap;}
  .name-field input{
    flex:1;
    background:transparent;
    border:none;
    outline:none;
    color:var(--text-light);
    font-family:'Baloo 2', sans-serif;
    font-weight:700;
    font-size:1.2rem;
    padding:10px 6px;
    min-width:0;
  }
  .name-field input::placeholder{ color:var(--text-dim); opacity:.6;}

  .mode-toggle-row{ display:flex; gap:10px; margin:0 0 22px; }
  .mode-btn{
    flex:1; text-align:left;
    background:var(--bg-panel-light); border:2px solid transparent;
    border-radius:14px; padding:12px 14px; cursor:pointer;
    color:var(--text-light); font-family:'Baloo 2', sans-serif;
    font-weight:800; font-size:1.05rem; display:flex; flex-direction:column; gap:2px;
  }
  .mode-btn .mode-sub{ font-family:'Nunito',sans-serif; font-weight:700; font-size:.72rem; color:var(--text-dim); }
  .mode-btn.selected{ border-color:var(--accent-yellow); background:rgba(255,210,63,.1); }
  .mode-btn.selected .mode-sub{ color:var(--text-light); opacity:.75; }

  .icon-btn{
    flex-shrink:0;
    width:42px; height:42px; border-radius:50%;
    background:var(--bg-panel); color:var(--text-light);
    border:2px solid var(--text-dim); font-size:1.3rem;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0; font-family:inherit;
  }
  .icon-btn:active{ transform:translateY(2px); }
  .icon-grid{
    display:grid; grid-template-columns:repeat(5, 1fr); gap:10px;
    margin:4px 0 0;
  }
  .icon-grid button{
    aspect-ratio:1; width:100%; border-radius:14px; font-size:1.6rem;
    background:var(--bg-panel-light); border:2px solid transparent;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0;
  }
  .icon-grid button:hover{ border-color:var(--text-dim); }
  .icon-grid button.selected{ border-color:var(--accent-yellow); background:rgba(255,210,63,.12); }

  .big-btn{
    font-family:'Baloo 2', sans-serif;
    font-weight:800;
    font-size:1.4rem;
    color:var(--bg-deep);
    background:var(--accent-yellow);
    border:none;
    border-radius:16px;
    padding:18px 40px;
    cursor:pointer;
    box-shadow:0 6px 0 #c99f1e, 0 10px 24px rgba(255,210,63,.25);
    transition:transform .08s ease;
  }
  .big-btn:active{ transform:translateY(4px); box-shadow:0 2px 0 #c99f1e; }
  .big-btn.secondary{
    background:var(--accent-teal);
    box-shadow:0 6px 0 #2f9891, 0 10px 24px rgba(78,205,196,.2);
  }
  .big-btn.secondary:active{ box-shadow:0 2px 0 #2f9891; }
  .big-btn.ghost{
    background:transparent;
    color:var(--text-light);
    box-shadow:none;
    border:2px solid var(--text-dim);
    font-size:1.1rem;
    padding:12px 26px;
  }
  .big-btn.small{ font-size:1.05rem; padding:12px 24px; }
  .big-btn.tertiary{
    background:var(--accent-coral);
    box-shadow:0 6px 0 #b23f3f, 0 10px 24px rgba(255,107,107,.25);
  }
  .big-btn.tertiary:active{ box-shadow:0 2px 0 #b23f3f; }
  .big-btn.quaternary{
    background:var(--accent-blue);
    box-shadow:0 6px 0 #3b6fc4, 0 10px 24px rgba(91,157,249,.25);
  }
  .big-btn.quaternary:active{ box-shadow:0 2px 0 #3b6fc4; }
  .big-btn.quinary{
    background:var(--accent-green);
    box-shadow:0 6px 0 #34a35f, 0 10px 24px rgba(95,212,138,.25);
  }
  .big-btn.quinary:active{ box-shadow:0 2px 0 #34a35f; }
  .big-btn.senary{
    background:var(--accent-purple);
    box-shadow:0 6px 0 #7c52c9, 0 10px 24px rgba(179,136,255,.25);
  }
  .big-btn.senary:active{ box-shadow:0 2px 0 #7c52c9; }
  .big-btn.septenary{
    background:var(--accent-orange);
    box-shadow:0 6px 0 #c9791e, 0 10px 24px rgba(255,159,64,.25);
  }
  .big-btn.septenary:active{ box-shadow:0 2px 0 #c9791e; }

  .mission-list{ display:flex; flex-direction:column; gap:14px; }
  .mission-btn{ width:100%; }

  .info-btn{
    position:absolute; top:14px; right:14px;
    width:34px; height:34px; border-radius:50%;
    background:var(--bg-panel-light); color:var(--accent-yellow);
    border:2px solid var(--text-dim); font-weight:800; font-size:1.15rem;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    font-family:'Baloo 2', sans-serif; padding:0;
  }
  .info-modal-backdrop{
    position:fixed; inset:0; z-index:60;
    background:rgba(10,10,26,.7);
    display:flex; align-items:center; justify-content:center;
    padding:20px;
  }
  .info-modal{
    max-width:420px; width:100%; text-align:left;
    max-height:calc(100vh - 40px); overflow-y:auto;
  }
  .info-modal p{ margin:0 0 10px; line-height:1.6; }
  .info-modal p:last-child{ margin-bottom:0; }

  .example-block .prompt{ margin-bottom:8px; font-size:1rem; }
  .example-block .sentence{ font-size:1.1rem; min-height:auto; margin-bottom:14px; }
  .example-opts{ display:flex; flex-direction:column; gap:6px; margin-bottom:4px; }
  .example-opt{
    background:var(--bg-panel-light); border-radius:10px; padding:8px 12px;
    font-weight:700; color:var(--text-light); font-size:.95rem;
  }
  .example-opt.correct{ background:#3a3720; border:2px solid var(--accent-yellow); color:var(--accent-yellow); }
  .example-divider{ border:none; border-top:1px dashed var(--text-dim); opacity:.3; margin:18px 0; }

  .rules{ text-align:left; color:var(--text-dim); font-weight:600; line-height:1.6; margin:0 0 22px; font-size:1.02rem;}
  .rules b{ color:var(--text-light); }

  /* ---- GAME SCREEN ---- */
  #screen-game .panel{ padding:28px 26px 34px; }
  .exit-row{ display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px; }
  .exit-btn{
    background:transparent; border:2px solid var(--accent-coral);
    color:var(--accent-coral); font-family:'Baloo 2', sans-serif;
    font-weight:800; font-size:.85rem; border-radius:12px;
    padding:6px 14px; cursor:pointer;
  }
  .exit-btn:active{ transform:translateY(2px); }
  .pause-btn{
    background:transparent; border:2px solid var(--accent-teal);
    color:var(--accent-teal); font-family:'Baloo 2', sans-serif;
    font-weight:800; font-size:.85rem; border-radius:12px;
    padding:6px 14px; cursor:pointer;
  }
  .pause-btn:active{ transform:translateY(2px); }
  .pause-btn.paused{ border-color:var(--accent-yellow); color:var(--accent-yellow); }

  .game-content{ position:relative; }

  .pause-overlay{
    position:absolute; inset:0; z-index:40;
    background:rgba(10,10,26,.9);
    border-radius:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .pause-overlay-inner{ text-align:center; }
  .pause-icon{ font-size:3rem; margin-bottom:8px; }
  .pause-title{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:1.4rem;
    color:var(--text-light); margin-bottom:20px;
  }

  .tracing-tab{
    position:absolute; top:50%; right:-2px;
    transform:translateY(-50%);
    width:44px; height:40px; border-radius:0 12px 12px 0;
    background:var(--bg-panel-light); border:2px solid var(--accent-yellow); border-left:none;
    color:var(--accent-yellow); font-size:1rem; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    z-index:32; padding:0;
    box-shadow:2px 4px 10px rgba(0,0,0,.3);
  }
  .tracing-tab:active{ transform:translateY(-50%) translateX(2px); }
  .tracing-paper{
    position:absolute; inset:0; z-index:30;
    border-radius:16px; overflow:hidden;
    background:rgba(250,246,228,.8);
    box-shadow:0 10px 30px rgba(0,0,0,.35);
    display:flex; flex-direction:column;
    transform:translateX(105%);
    transition:transform .3s ease;
    pointer-events:none;
  }
  .tracing-paper.open{ transform:translateX(0); pointer-events:auto; }
  .tracing-toolbar{
    display:flex; align-items:center; flex-wrap:wrap; gap:8px;
    padding:10px 14px; flex-shrink:0;
    background:rgba(0,0,0,.1);
    border-bottom:1px dashed rgba(0,0,0,.25);
  }
  .tracing-label{ font-family:'Baloo 2',sans-serif; font-weight:800; color:#4a4430; font-size:.9rem; margin-right:auto; }
  .tracing-tools{ display:flex; gap:4px; }
  .tracing-tool-btn{
    font-family:'Baloo 2',sans-serif; font-weight:800; font-size:.78rem;
    background:rgba(0,0,0,.08); border:2px solid transparent; border-radius:10px;
    padding:6px 10px; cursor:pointer; color:#4a4430;
  }
  .tracing-tool-btn.active{ background:rgba(255,210,63,.45); border-color:#b8860b; }
  .tracing-tool-btn:active{ transform:translateY(1px); }
  .tracing-btn{
    font-family:'Baloo 2',sans-serif; font-weight:800; font-size:.78rem;
    background:rgba(0,0,0,.08); border:none; border-radius:10px;
    padding:6px 12px; cursor:pointer; color:#4a4430;
  }
  .tracing-btn:active{ transform:translateY(1px); }
  .tracing-canvas-wrap{ position:relative; flex:1; min-height:260px; }
  #tracing-canvas{ position:absolute; inset:0; width:100%; height:100%; display:block; touch-action:none; cursor:crosshair; }
  .ruler-overlay{
    position:absolute; top:0; left:0;
    height:26px;
    transform-origin:0 50%;
    background:repeating-linear-gradient(90deg, rgba(120,90,20,.4) 0 2px, rgba(210,170,70,.6) 2px 10px);
    border:1px solid rgba(120,90,20,.75);
    border-radius:4px;
    pointer-events:none;
    z-index:5;
  }

  .speed-sky{
    position:relative; height:110px; border-radius:16px; overflow:hidden;
    margin-bottom:20px;
    background:linear-gradient(180deg, #4a90d9 0%, #8fc6ec 70%, #bfe0f5 100%);
  }
  /* The cloud layer holds two identical sets of clouds back-to-back (0-80%
     and 105-180%, a mirror of the first set shifted by exactly 100%), then
     scrolls left by exactly 100% of its own width on a seamless infinite
     loop -- as the first set exits on the left, the second set is already
     sitting in the position the first set started in, so the loop point is
     invisible. This, together with the scrolling ground below, is what
     sells "the bird is flying forward" rather than just falling in place. */
  .speed-clouds{
    position:absolute; inset:0;
    animation:speedCloudScroll 26s linear infinite;
  }
  .speed-cloud{ position:absolute; font-size:1.3rem; opacity:.8; }
  @keyframes speedCloudScroll{
    from{ transform:translateX(0); }
    to{ transform:translateX(-100%); }
  }
  .speed-ground{
    position:absolute; left:0; right:0; bottom:0; height:14px;
    background-image:
      repeating-linear-gradient(90deg, #7d5029 0 18px, #6b431f 18px 36px);
    border-top:3px solid #5fa84a;
    animation:speedGroundScroll .6s linear infinite;
  }
  @keyframes speedGroundScroll{
    from{ background-position-x:0; }
    to{ background-position-x:-36px; }
  }
  /* Paused (or crashed) freezes every scrolling/flapping layer in place,
     rather than letting the scenery keep drifting behind a stopped bird. */
  .speed-sky.speed-frozen .speed-clouds,
  .speed-sky.speed-frozen .speed-ground,
  .speed-sky.speed-frozen .speed-bird{
    animation-play-state:paused;
  }
  .speed-bird{
    position:absolute; left:50%; bottom:14px;
    /* scaleX(-1) mirrors the emoji left-to-right so it faces the direction
       of travel; it's appended to every keyframe below too, since an
       animated "transform" replaces the whole property per frame rather
       than combining with this base rule. */
    transform:translateX(-50%) scaleX(-1);
    font-size:1.8rem; line-height:1;
    transition:bottom .25s ease-out;
    animation:speedBirdFlap .5s ease-in-out infinite alternate;
  }
  @keyframes speedBirdFlap{
    from{ transform:translateX(-50%) rotate(-6deg) scaleX(-1); }
    to{ transform:translateX(-50%) rotate(6deg) scaleX(-1); }
  }
  .speed-bird.boost{ animation:speedBirdBoost .35s ease-out; }
  @keyframes speedBirdBoost{
    0%{ transform:translateX(-50%) scale(1) rotate(0deg) scaleX(-1); }
    40%{ transform:translateX(-50%) scale(1.35) rotate(-14deg) scaleX(-1); }
    100%{ transform:translateX(-50%) scale(1) rotate(0deg) scaleX(-1); }
  }
  .speed-bird.drop{ animation:speedBirdDrop .35s ease-in; }
  @keyframes speedBirdDrop{
    0%{ transform:translateX(-50%) scale(1) rotate(0deg) scaleX(-1); }
    40%{ transform:translateX(-50%) scale(.85) rotate(18deg) scaleX(-1); }
    100%{ transform:translateX(-50%) scale(1) rotate(0deg) scaleX(-1); }
  }
  .speed-bird.crashed{
    animation:none !important;
    transform:translateX(-50%) rotate(90deg) scaleX(-1) !important;
    transition:bottom .4s ease-in, transform .4s ease-in;
  }

  .hud{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:22px;
    gap:12px;
  }
  .score-box{ text-align:left; }
  .score-label{ font-size:.7rem; letter-spacing:2px; color:var(--text-dim); font-weight:800;}
  .score-value{
    font-family:'Press Start 2P', monospace;
    font-size:1.7rem;
    color:var(--accent-yellow);
    transition:transform .15s ease;
  }
  .score-value.bump{ transform:scale(1.25); }
  .player-name{
    font-family:'Baloo 2', sans-serif;
    font-weight:700;
    font-size:1.1rem;
    color:var(--text-light);
    max-width:180px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .streak-box{ font-size:1.3rem; text-align:right; min-width:60px;}

  .prompt{
    font-weight:800; font-size:1.1rem; color:var(--accent-teal);
    text-transform:uppercase; letter-spacing:1px; margin-bottom:14px;
  }
  .sentence{
    font-family:'Baloo 2', sans-serif;
    font-weight:700;
    font-size:clamp(1.5rem, 4.2vw, 2.15rem);
    line-height:2.35;
    color:var(--text-light);
    margin-bottom:30px;
    min-height:5.4em;
    text-align:left;
  }
  .hl-target{
    /* This span always exists around the target word, from the very
       first render, whether or not it's revealed. Only the .revealed
       class below changes anything, so no layout recalculation happens
       when a mistake is revealed — the box was always there. */
    border-radius:6px;
    transition:background-color .15s ease;
  }
  .hl-target.revealed{
    /* Highlight is painted with background + box-shadow only — no
       padding or margin — so the word's box stays exactly the width of
       the plain text and the line never re-wraps when this is added.
       The spread is kept modest (and line-height opened up above) so
       it never bleeds into the sentence line above or below it. */
    background:var(--accent-coral);
    color:#231313;
    box-shadow:0 0 0 4px var(--accent-coral), 0 0 0 6px rgba(255,107,107,.35);
  }
  .hl-target.hl-given{
    /* Synonym/antonym rounds highlight the key word from the very start
       (it's given, not the answer), so this uses a distinct teal tone
       that's always on rather than only appearing after a mistake. */
    background:var(--accent-teal);
    color:#0b2422;
    box-shadow:0 0 0 4px var(--accent-teal), 0 0 0 6px rgba(78,205,196,.35);
  }
  .compound-columns{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:18px;
    flex-wrap:wrap;
  }
  .compound-col{
    display:flex;
    flex-direction:column;
    gap:10px;
    background:var(--bg-panel-light);
    border-radius:14px;
    padding:14px 22px;
    min-width:140px;
  }
  .compound-word{
    font-family:'Baloo 2', sans-serif;
    font-weight:800;
    font-size:1.25rem;
    line-height:1.3;
    color:var(--text-light);
    text-align:center;
    letter-spacing:.5px;
  }
  .compound-plus{
    font-size:1.8rem;
    font-weight:800;
    color:var(--accent-teal);
    flex-shrink:0;
  }
  .compound-answer{
    width:100%;
    text-align:center;
    font-size:1.15rem;
    line-height:1.4;
    font-weight:800;
    color:var(--text-dim);
    margin-top:14px;
  }
  .compound-answer .hl-target{ color:inherit; }
  .compound-answer .hl-target.revealed{ color:#231313; }

  .pair-analogy{
    display:flex; flex-direction:row; flex-wrap:wrap;
    align-items:center; justify-content:center; gap:10px 16px;
  }
  .pair-box{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:1.6rem;
    letter-spacing:2px; color:var(--text-light);
    background:var(--bg-panel-light); border-radius:12px;
    padding:10px 20px; min-width:70px; text-align:center;
  }
  .pair-link{ font-size:.85rem; font-weight:700; color:var(--text-dim); text-transform:uppercase; letter-spacing:.5px; }
  .pair-as{ font-size:.9rem; font-weight:800; color:var(--accent-purple); text-transform:uppercase; letter-spacing:1px; }
  .pair-answer{ color:var(--accent-purple); }
  .pair-answer .hl-target{ color:inherit; }
  .pair-answer .hl-target.revealed{ color:#f4f2ec; }

  /* ---- "Spot the punctuation mistake" mode (real GL Assessment format) --
     kept deliberately compact (smaller font, tight line-height) so a
     4-part passage doesn't push the page taller than a normal question. */
  .spot-passage{
    font-size:1.15rem; line-height:2.3; font-weight:700; text-align:left;
  }
  .spot-chunk{ border-radius:6px; padding:1px 3px; }
  .spot-tag{
    display:inline-flex; align-items:center; justify-content:center;
    width:19px; height:19px; margin-right:5px;
    background:rgba(255,255,255,.1); color:var(--text-dim);
    border-radius:5px; font-size:.65rem; font-weight:800; vertical-align:2px;
  }
  .spot-chunk.hl-target.revealed .spot-tag{ background:rgba(0,0,0,.2); color:inherit; }
  .spot-n-chip{
    display:inline-flex; align-items:center; margin-top:8px;
    font-size:.85rem; font-weight:700; color:var(--text-dim);
    border-radius:8px; padding:3px 8px 3px 3px;
  }

  /* ---- Alphabet reference strip (Letter Pair Puzzles helper tool) ---- */
  .alphabet-strip{
    background:var(--bg-panel-light); border-radius:14px;
    padding:10px 14px 12px; margin-bottom:20px; text-align:left;
  }
  .ab-header{
    display:flex; align-items:center; justify-content:space-between;
    gap:10px; margin-bottom:6px;
  }
  .ab-title{ font-size:.72rem; color:var(--text-dim); font-weight:700; line-height:1.3; }
  .ab-clear-btn{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:.72rem;
    background:rgba(255,255,255,.08); border:2px solid transparent; border-radius:8px;
    padding:5px 12px; cursor:pointer; color:var(--text-light); flex-shrink:0;
  }
  .ab-clear-btn:active{ transform:translateY(1px); }
  .ab-scroll{
    position:relative; overflow-x:auto; overflow-y:visible;
    padding-top:18px; padding-bottom:18px; transition:padding .15s ease;
  }
  .ab-arcs{ position:absolute; top:0; left:0; pointer-events:none; overflow:visible; }
  .ab-arc-path{ fill:none; stroke-width:2; }
  .ab-arc-label{ font-size:13px; font-weight:800; font-family:'Baloo 2', sans-serif; }
  .ab-row{
    display:inline-flex; gap:3px; white-space:nowrap; position:relative; z-index:1;
  }
  .ab-letter{
    display:inline-flex; align-items:center; justify-content:center;
    width:23px; height:26px; flex-shrink:0;
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:.82rem;
    border-radius:6px; background:rgba(255,255,255,.07); color:var(--text-light);
    cursor:pointer; user-select:none; -webkit-user-select:none;
  }
  .ab-letter:hover{ background:var(--accent-teal); color:#0b2422; }
  .ab-letter.ab-mirror-hint{ background:var(--accent-purple); color:#fff; }
  .ab-letter.ab-selected{ background:var(--accent-yellow); color:#231313; box-shadow:0 0 0 2px rgba(255,210,63,.6); }

  .options{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(200px,1fr));
    gap:14px;
  }
  .opt-btn{
    display:flex; align-items:center; gap:12px;
    background:var(--bg-panel-light);
    border:2px solid transparent;
    border-radius:14px;
    padding:16px 18px;
    font-family:'Nunito',sans-serif;
    font-weight:800;
    font-size:1.25rem;
    color:var(--text-light);
    cursor:pointer;
    text-align:left;
    transition:border-color .12s ease, transform .08s ease;
  }
  .opt-btn:hover{ border-color:var(--accent-teal); }
  .opt-btn:active{ transform:scale(.97); }
  .opt-num{
    font-family:'Press Start 2P', monospace;
    font-size:.85rem;
    background:var(--bg-deep);
    color:var(--accent-yellow);
    border-radius:8px;
    width:32px; height:32px;
    flex:0 0 auto;
    display:flex; align-items:center; justify-content:center;
  }
  .opt-btn.correct{ border-color:var(--accent-yellow); background:#3a3720; }
  .opt-btn.correct .opt-num{ background:var(--accent-yellow); color:var(--bg-deep); }
  .opt-btn.wrong{ border-color:var(--accent-coral); background:#3a2222; opacity:.75; }
  .opt-btn[disabled]{ cursor:default; }

  .continue-hint{
    margin-top:22px; color:var(--text-dim); font-weight:700;
    font-size:1rem;
    animation:pulse 1.4s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{opacity:.55;} 50%{opacity:1;} }
  kbd{
    background:var(--bg-deep); border-radius:6px; padding:3px 10px;
    font-family:'Press Start 2P', monospace; font-size:.7rem; color:var(--accent-yellow);
  }

  /* ---- RESULTS ---- */
  .results-grid{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(90px,1fr)); gap:14px; margin:26px 0;
  }
  .stat{
    background:var(--bg-panel-light); border-radius:16px; padding:18px 8px;
  }
  .stat-num{
    font-family:'Press Start 2P', monospace;
    font-size:1.5rem; color:var(--accent-yellow); margin-bottom:8px;
  }
  .stat-label{ font-size:.78rem; color:var(--text-dim); font-weight:800; letter-spacing:.5px;}

  .review-row{
    text-align:left; background:var(--bg-panel-light); border-radius:14px;
    padding:16px 18px; margin-bottom:12px;
  }
  .review-row .rtype{ font-size:.75rem; color:var(--accent-teal); font-weight:800; letter-spacing:1px; text-transform:uppercase; margin-bottom:6px;}
  .review-row .rsentence{ font-family:'Baloo 2',sans-serif; font-size:1.15rem; margin-bottom:8px; line-height:1.5;}
  .review-row .rmeta{ font-size:.95rem; color:var(--text-dim); font-weight:700;}
  .review-row .rmeta b{ color:var(--accent-coral); }
  .review-row .rmeta b.ok{ color:var(--accent-yellow); }
  .review-row .rwhy{
    font-size:.92rem; color:var(--text-light); font-weight:600; line-height:1.5;
    margin-top:10px; padding:10px 12px;
    background:rgba(255,210,63,.1); border-left:3px solid var(--accent-yellow);
    border-radius:6px;
  }
  .review-row .rwhy .rwhy-label{ color:var(--accent-yellow); font-weight:800; text-transform:uppercase; font-size:.72rem; letter-spacing:.5px; margin-right:4px; }

  .btn-row{ display:flex; gap:14px; justify-content:center; margin-top:8px; flex-wrap:wrap;}

  /* ---- LEADERBOARD ---- */
  .lb-table{ width:100%; border-collapse:collapse; text-align:left; margin-bottom:10px;}
  .lb-table th{
    font-size:.72rem; letter-spacing:1px; color:var(--text-dim); text-transform:uppercase;
    padding:8px 10px; border-bottom:2px solid var(--bg-panel-light);
  }
  .lb-table td{
    font-weight:700; padding:12px 10px; border-bottom:1px solid var(--bg-panel-light);
    font-size:1rem;
  }
  .lb-table tr.me{ background:rgba(255,210,63,.08); }
  .lb-rank{ font-family:'Press Start 2P', monospace; font-size:.8rem; color:var(--accent-yellow); }
  .lb-icon{ font-size:1.25rem; text-align:center; }
  .lb-name{ font-family:'Baloo 2', sans-serif; font-weight:700; font-size:1.1rem; }
  .lb-empty{ color:var(--text-dim); font-weight:700; padding:24px 0; }
  .lb-tabs{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
  .lb-tab{
    background:var(--bg-panel-light); border:2px solid transparent; border-radius:12px;
    padding:8px 14px; font-family:'Baloo 2', sans-serif; font-weight:800; font-size:.85rem;
    color:var(--text-light); cursor:pointer;
  }
  .lb-tab.active{ border-color:var(--accent-yellow); background:rgba(255,210,63,.12); color:var(--accent-yellow); }

  /* ---- NAME SWITCH SUB-CARD ---- */
  .switch-card{
    background:var(--bg-panel-light); border-radius:16px; padding:18px; margin:20px 0; text-align:left;
  }

  /* ---- ADDITION ALLEY ---- */
  #screen-addition{ max-width:920px; }
  .aa-hud{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:18px; gap:12px; flex-wrap:wrap;
  }
  .aa-qcount{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:1rem;
    color:var(--accent-orange);
  }
  .aa-track{
    position:relative; height:86px; border-radius:16px; overflow:hidden;
    margin-bottom:22px;
    background:linear-gradient(180deg, #1c2340 0%, #2a2f58 100%);
    border:2px solid rgba(255,255,255,.06);
  }
  .aa-track-line{
    position:absolute; left:4%; right:6%; bottom:22px; height:4px;
    background:repeating-linear-gradient(90deg, rgba(255,255,255,.3) 0 10px, transparent 10px 20px);
  }
  .aa-obstacle{
    position:absolute; bottom:16px; transform:translateX(-50%);
    font-size:1.6rem;
  }
  .aa-rocket{
    position:absolute; bottom:14px; transform:translateX(-50%);
  }
  /* A hand-drawn SVG rather than the 🚀 emoji — most emoji fonts draw that
     rocket leaning at a jaunty diagonal, which reads wrong next to a liftoff
     animation that climbs straight up. */
  .aa-rocket svg{ display:block; width:30px; height:39px; }
  /* Launching lifts the rocket out of the track's own clipped box so it can
     climb far above the panel for real liftoff drama, instead of vanishing
     into the 86px-tall strip after a few pixels. */
  .aa-track.launching{ overflow:visible; z-index:30; }
  .aa-rocket.launch{ animation:aaRocketLaunch 1.9s cubic-bezier(.5,0,.75,.65) forwards; z-index:5; }
  @keyframes aaRocketLaunch{
    0%{ transform:translateX(-50%) translateY(0) rotate(0deg) scale(1); opacity:1; }
    6%{ transform:translateX(-50%) translateY(1px) rotate(-3deg) scale(1.03); }
    12%{ transform:translateX(-50%) translateY(-1px) rotate(3deg) scale(1.03); }
    18%{ transform:translateX(-50%) translateY(0) rotate(-2deg) scale(1.03); }
    26%{ transform:translateX(-50%) translateY(-18px) rotate(0deg) scale(1.1); }
    50%{ transform:translateX(-50%) translateY(-220px) rotate(0deg) scale(.85); }
    78%{ transform:translateX(-50%) translateY(-560px) rotate(0deg) scale(.45); }
    100%{ transform:translateX(-50%) translateY(-880px) rotate(0deg) scale(.15); opacity:0; }
  }
  .aa-flame{
    position:absolute; bottom:-2px; left:50%; transform:translateX(-50%);
    font-size:1.1rem; opacity:0; pointer-events:none;
  }
  .aa-rocket.launch .aa-flame{ animation:aaFlameFlicker 1.9s cubic-bezier(.5,0,.75,.65) forwards; }
  @keyframes aaFlameFlicker{
    0%{ opacity:0; } 10%{ opacity:1; } 90%{ opacity:1; } 100%{ opacity:0; }
  }
  .aa-runner{
    position:absolute; bottom:18px; left:2%;
    /* scaleX(-1) mirrors the emoji so it faces right, the direction of
       travel; it's appended to every keyframe below too, since an animated
       "transform" replaces the whole property per frame rather than
       combining with this base rule. */
    transform:translateX(-50%) scaleX(-1);
    font-size:1.9rem; transition:left .8s ease-in-out;
  }
  .aa-runner.jump{ animation:aaRunnerJump .7s ease-in-out; }
  .aa-runner.hidden{ display:none; }
  @keyframes aaRunnerJump{
    0%{ transform:translateX(-50%) translateY(0) scaleX(-1); }
    40%{ transform:translateX(-50%) translateY(-34px) rotate(-8deg) scaleX(-1); }
    60%{ transform:translateX(-50%) translateY(-34px) rotate(6deg) scaleX(-1); }
    100%{ transform:translateX(-50%) translateY(0) scaleX(-1); }
  }
  .aa-story-box{
    display:flex; align-items:flex-start; gap:14px;
    background:var(--bg-panel-light); border-radius:16px;
    padding:18px 20px; margin-bottom:22px;
  }
  .aa-speak-btn{
    flex-shrink:0;
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:.85rem;
    background:var(--accent-teal); color:var(--bg-deep); border:none;
    border-radius:12px; padding:10px 14px; cursor:pointer;
    box-shadow:0 4px 0 #2f9891;
  }
  .aa-speak-btn:active{ transform:translateY(3px); box-shadow:none; }
  .aa-speak-btn[disabled]{ opacity:.4; cursor:not-allowed; }
  .aa-story{
    font-family:'Baloo 2', sans-serif; font-weight:700;
    font-size:clamp(1.1rem, 2.6vw, 1.35rem); line-height:1.6;
    color:var(--text-light); text-align:left;
  }
  .aa-grid-wrap{ overflow-x:auto; padding-bottom:6px; margin-bottom:14px; display:flex; justify-content:center; }
  /* Digit columns are a fixed width rather than a flexible 1fr, so with a
     small question (few columns) the grid doesn't stretch to fill the whole
     panel and scatter the digits apart — it sizes to its own content and
     the wrapper above centers it instead. */
  .aa-grid{ display:inline-grid; column-gap:4px; row-gap:8px; align-items:center; }
  .aa-col-head{
    display:flex; flex-direction:column; align-items:center; gap:3px;
    position:relative;
  }
  .aa-col-head-label{
    font-family:'Baloo 2', sans-serif; font-weight:800; font-size:.92rem;
    color:var(--accent-yellow); white-space:nowrap;
  }
  .aa-col-info-btn{
    width:20px; height:20px; border-radius:50%;
    background:var(--bg-panel-light); color:var(--text-dim);
    border:1px solid var(--text-dim); font-size:.68rem; font-weight:800;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    padding:0; line-height:1;
  }
  .aa-col-info-btn:hover{ color:var(--accent-yellow); border-color:var(--accent-yellow); }
  .aa-col-info-pop{
    position:absolute; top:100%; left:50%; transform:translateX(-50%);
    width:150px; background:var(--bg-deep); color:var(--text-light);
    border:1px solid var(--accent-yellow); border-radius:10px;
    padding:8px 10px; font-size:.72rem; font-weight:600; line-height:1.4;
    z-index:12; display:none; box-shadow:0 6px 18px rgba(0,0,0,.4);
    margin-top:6px; text-align:left;
  }
  .aa-col-info-pop.show{ display:block; }
  .aa-digit{
    font-family:'Baloo 2', sans-serif; font-weight:700; font-size:1.5rem;
    color:var(--text-light); text-align:center; min-width:36px;
  }
  .aa-decimal{
    font-family:'Baloo 2', sans-serif; font-weight:900; font-size:1.5rem;
    color:var(--text-dim); text-align:center;
  }
  .aa-plus-sign{
    font-family:'Baloo 2', sans-serif; font-weight:900; font-size:1.5rem;
    color:var(--accent-coral); text-align:center;
  }
  .aa-unit-sign{
    font-family:'Baloo 2', sans-serif; font-weight:900; font-size:1.4rem;
    color:var(--accent-yellow); text-align:center;
  }
  /* A single bar spanning every column, rather than a border on each
     column's cell, so the rule reads as one unbroken straight line instead
     of being visibly chopped up by the column gaps. */
  .aa-rule-bar{
    grid-column:1 / -1;
    height:3px;
    background:var(--text-light);
    border-radius:2px;
    margin:2px 0;
  }
  .aa-cell{
    width:36px; height:48px; text-align:center;
    font-family:'Press Start 2P', monospace; font-size:1.05rem;
    background:var(--bg-panel-light); color:var(--text-light);
    border:3px solid var(--accent-blue); border-radius:10px;
    outline:none; caret-color:var(--accent-yellow);
  }
  /* Step 1 — entering the addends themselves — gets its own border colour
     so it visually reads as a different stage from the answer/carry boxes. */
  .aa-cell[data-kind="addend"]{ border-color:var(--accent-teal); }
  .aa-cell:focus{ border-color:var(--accent-yellow); }
  .aa-cell[disabled]{ opacity:.5; }
  .aa-cell.aa-correct{ border-color:var(--accent-green); background:#20331f; color:var(--accent-green); }
  .aa-cell.aa-wrong{ border-color:var(--accent-orange); background:#3a2a16; color:var(--accent-orange); animation:aaShake .3s ease; }
  @keyframes aaShake{
    0%,100%{ transform:translateX(0); } 25%{ transform:translateX(-4px); } 75%{ transform:translateX(4px); }
  }
  .aa-carry-cell{
    width:30px; height:32px; font-size:.75rem;
    border-width:2px; border-color:var(--accent-purple);
    background:var(--bg-panel);
  }
  .aa-carry-dash{
    width:30px; height:32px; display:flex; align-items:center; justify-content:center;
    color:var(--text-dim); font-size:.9rem; font-weight:800;
  }
  .aa-feedback{
    min-height:1.6em; font-family:'Baloo 2', sans-serif; font-weight:800;
    font-size:1.05rem; color:var(--accent-green); text-align:center;
  }

  @media (max-width:480px){
    .panel{ padding:22px 16px 26px; border-radius:18px; }
    .results-grid{ grid-template-columns:repeat(auto-fit, minmax(80px,1fr)); gap:8px;}
    .stat{ padding:12px 4px; }
    .stat-num{ font-size:1.1rem; }
    .lb-table th, .lb-table td{ padding:8px 6px; font-size:.85rem; }
    .aa-cell{ width:32px; height:40px; font-size:.82rem; }
    .aa-carry-cell{ width:24px; height:26px; font-size:.65rem; }
    .aa-carry-dash{ width:24px; height:26px; }
    .aa-digit{ font-size:1.2rem; min-width:32px; }
    .aa-decimal, .aa-plus-sign, .aa-unit-sign{ font-size:1.2rem; }
    .aa-track{ height:72px; }
    .aa-runner{ font-size:1.5rem; }
    .aa-obstacle{ font-size:1.3rem; }
    .aa-rocket svg{ width:24px; height:31px; }
  }
</style>
</head>
<body>
<div id="starfield"></div>
<datalist id="pilot-names"></datalist>
<div id="app">

  <!-- CATEGORY SCREEN -->
  <div class="screen" id="screen-category">
    <div class="logo">WORD OPS</div>
    <div class="tagline">Choose your mission type</div>
    <div class="panel" style="position:relative;">
      <button class="info-btn" id="btn-info" aria-label="About the question bank" title="About the question bank">ⓘ</button>
      <div class="mission-list">
        <button class="big-btn mission-btn" data-category="grammar">🔤 Prepositions &amp; Determiners</button>
        <button class="big-btn secondary mission-btn" data-category="spelling">✏️ Spelling &amp; Punctuation</button>
        <button class="big-btn tertiary mission-btn" data-category="synonyms">🔁 Synonyms &amp; Antonyms</button>
        <button class="big-btn quaternary mission-btn" data-category="meanings">📚 Vocabulary Meanings</button>
        <button class="big-btn quinary mission-btn" data-category="compound">🧩 Compound Words</button>
        <button class="big-btn senary mission-btn" data-category="letterpair">🔗 Letter Pair Puzzles</button>
        <button class="big-btn septenary mission-btn" data-category="addition">🚀 Addition Alley</button>
        <button class="big-btn ghost mission-btn" data-category="all">🌟 All of the Above</button>
      </div>
      <div class="btn-row" style="margin-top:18px;">
        <button class="big-btn ghost" id="btn-category-leaderboard">🏆 Scoreboard</button>
      </div>
    </div>
  </div>

  <!-- START SCREEN -->
  <div class="screen hidden" id="screen-start">
    <div class="logo">WORD OPS</div>
    <div class="tagline">Mission Control</div>
    <div class="panel">
      <div class="rules" id="start-rules-standard">
        <p><b>Mission:</b> A sentence appears with 5 possible answers. Press the number key (or tap) for the correct word or option — whichever your chosen mission asks for.</p>
        <p><b>Correct</b> → you hear the chime and points land. <b>Wrong</b> → the right answer lights up so you can see it, then press <kbd>SPACE</kbd> to continue.</p>
        <p>Answer as many as you can before mission time runs out. Ready?</p>
      </div>
      <div class="rules hidden" id="start-rules-addition">
        <p><b>Mission:</b> 5 money word problems, solved with the column method. Tap 🔊 to have each problem read aloud, then fill in the answer boxes — right-hand column first.</p>
        <p>Get a digit right and it locks in green. Get it wrong and it flashes orange so you can try again — no penalty, just keep going.</p>
        <p>Finish a problem and your rocket pilot leaps the next obstacle on the runway. Clear all 5 and the rocket launches!</p>
      </div>
      <div class="name-field" style="justify-content:space-between;">
        <label style="white-space:normal;">Mission: <span id="mission-name" style="color:var(--accent-yellow);"></span></label>
        <div style="display:flex; gap:8px; flex-shrink:0;">
          <button class="big-btn ghost small" id="btn-view-example" style="padding:8px 14px; font-size:.8rem;">👁 Example</button>
          <button class="big-btn ghost small" id="btn-change-mission" style="padding:8px 16px; font-size:.85rem;">Change</button>
        </div>
      </div>
      <div class="mode-toggle-row" id="mode-toggle-row">
        <button type="button" class="mode-btn selected" id="mode-btn-classic" data-mode="classic">🕐 Classic<span class="mode-sub">5 minute mission</span></button>
        <button type="button" class="mode-btn" id="mode-btn-speed" data-mode="speed">🐦 Speed Round<span class="mode-sub">60s — correct +3s, wrong −2s</span></button>
      </div>
      <div class="name-field">
        <button type="button" class="icon-btn" id="btn-pick-icon-start" title="Choose your icon">🚀</button>
        <label for="name-input">Pilot name</label>
        <input type="text" id="name-input" list="pilot-names" placeholder="Enter your name (like a username)" maxlength="18" autocomplete="off">
      </div>
      <div id="name-recognition" style="color:var(--text-dim); font-weight:700; font-size:.85rem; margin:-14px 4px 18px; min-height:1.2em;"></div>
      <div class="btn-row">
        <button class="big-btn" id="btn-start">🚀 START MISSION</button>
        <button class="big-btn ghost" id="btn-start-leaderboard">🏆 Scoreboard</button>
        <button class="big-btn ghost" id="btn-start-corrections">📖 My Corrections</button>
      </div>
    </div>
  </div>

  <!-- GAME SCREEN -->
  <div class="screen hidden" id="screen-game">
    <div class="panel">
      <div class="exit-row">
        <button class="pause-btn" id="btn-pause">⏸ Pause</button>
        <button class="exit-btn" id="btn-exit-mission">✕ Exit Mission</button>
      </div>
      <div class="game-content" id="game-content">
        <div class="alphabet-strip hidden" id="alphabet-strip">
          <div class="ab-header">
            <span class="ab-title">🔤 Hover a letter to see its mirror &middot; click two letters to measure the gap between them</span>
            <button type="button" class="ab-clear-btn" id="btn-ab-clear">Clear</button>
          </div>
          <div class="ab-scroll" id="ab-scroll">
            <svg class="ab-arcs" id="ab-arcs"></svg>
            <div class="ab-row" id="ab-row"></div>
          </div>
        </div>
        <div class="speed-sky hidden" id="speed-sky">
          <div class="speed-clouds" id="speed-clouds">
            <span class="speed-cloud" style="left:5%; top:14%;">☁️</span>
            <span class="speed-cloud" style="left:28%; top:42%;">☁️</span>
            <span class="speed-cloud" style="left:52%; top:22%;">☁️</span>
            <span class="speed-cloud" style="left:78%; top:48%;">☁️</span>
            <span class="speed-cloud" style="left:105%; top:14%;">☁️</span>
            <span class="speed-cloud" style="left:128%; top:42%;">☁️</span>
            <span class="speed-cloud" style="left:152%; top:22%;">☁️</span>
            <span class="speed-cloud" style="left:178%; top:48%;">☁️</span>
          </div>
          <div class="speed-bird" id="speed-bird">🐦</div>
          <div class="speed-ground" id="speed-ground"></div>
        </div>
        <div class="hud">
          <div class="score-box">
            <div class="score-label">SCORE</div>
            <div class="score-value" id="score-value">0</div>
          </div>
          <div class="player-name" id="hud-player-name"></div>
          <div class="streak-box" id="streak-box"></div>
