  /* ---------------- HELPERS ---------------- */
  function shuffle(arr){
    const a = arr.slice();
    for(let i=a.length-1;i>0;i--){
      const j = Math.floor(Math.random()*(i+1));
      [a[i],a[j]] = [a[j],a[i]];
    }
    return a;
  }

  let lastQuestionId = null; // guards against an immediate repeat when the queue reshuffles

  function refillQueue(){
    const pool = selectedTypes ? QUESTIONS.filter(q => selectedTypes.indexOf(q.type) !== -1) : QUESTIONS;
    queue = shuffle(pool);
    // The next question served is queue[queue.length - 1] (we pop from the
    // end). A fresh shuffle can land the very question that was just shown
    // right back in that spot by chance — a visible "stuck" repeat — so
    // swap it out for a different position when there's more than one
    // question to choose from.
    if(queue.length > 1 && lastQuestionId !== null){
      const topIdx = queue.length - 1;
      if(questionId(queue[topIdx]) === lastQuestionId){
        const swapWith = Math.floor(Math.random() * (queue.length - 1));
        [queue[topIdx], queue[swapWith]] = [queue[swapWith], queue[topIdx]];
      }
    }
  }

  function nextQuestionData(){
    if(queue.length === 0) refillQueue();
    const q = queue.pop();
    lastQuestionId = questionId(q);
    return q;
