  function stripPunct(w){
    return w.replace(/^[^\w']+|[^\w']+$/g, '');
  }

  function renderSentence(q, revealed){
    // Three rendering modes share one sentence display:
    //  - "blank"   (spelling/punctuation): sentence has a literal "_____"
    //    placeholder; the answer fills it in only once revealed.
    //  - "related" (synonym/antonym): the given word is already present
    //    in the sentence and is highlighted from the very start — it's
    //    the subject of the question, not the answer being guessed.
    //  - default/"inline" (determiner/preposition): the target word IS
    //    the answer, sitting among the sentence's own words, and is only
    //    highlighted once revealed as a wrong-answer hint.
    if(q.mode === 'blank'){
      const idx = q.sentence.indexOf('_____');
      const before = q.sentence.slice(0, idx);
      const after = q.sentence.slice(idx + 5);
      const fill = revealed
        ? '<span class="hl-target revealed">' + q.correct + '</span>'
        : '<span class="hl-target">_____</span>';
      return before + fill + after;
    }
    if(q.mode === 'related'){
      const tokens = q.sentence.split(' ');
      return tokens.map(tok => {
        const bare = stripPunct(tok);
        if(bare.toLowerCase() === q.target.toLowerCase()){
          return '<span class="hl-target hl-given">' + tok + '</span>';
        }
        return tok;
      }).join(' ');
    }
    if(q.mode === 'define'){
      // Vocabulary-meanings mode: the sentence IS the definition being
      // tested, so there's no word embedded in it to highlight. Instead we
      // append an answer-indicator span at the end — "?" until revealed,
      // then the matching word — kept in the DOM from the first render so
      // reveal only ever toggles a class, same as every other mode.
      const fill = revealed
        ? '<span class="hl-target revealed">' + q.correct + '</span>'
        : '<span class="hl-target">?</span>';
      return q.sentence + ' &rarr; ' + fill;
    }
    if(q.mode === 'compound'){
      // Compound-word mode: the sentence shows two bracketed word pools, and
      // the answer is which pairing joins them into a real word — nothing
      // in the sentence itself to highlight, so this uses the same
      // arrow-reveal trick as "define" mode. The two pools are laid out as
      // columns (one word per row) rather than an inline slash-separated
      // list, so the word choices are easier to scan at a glance.
      const fill = revealed
        ? '<span class="hl-target revealed">' + q.correct + '</span>'
        : '<span class="hl-target">?</span>';
      const groups = q.sentence.match(/\(([^)]+)\)\s*\+\s*\(([^)]+)\)/);
      if(groups){
        const col = group => '<div class="compound-col">' + group.split('/')
          .map(w => '<div class="compound-word">' + w.trim() + '</div>').join('') + '</div>';
        return '<div class="compound-columns">' + col(groups[1]) + '<div class="compound-plus">+</div>' + col(groups[2]) + '</div>' +
          '<div class="compound-answer">' + fill + '</div>';
      }
      return q.sentence + ' &rarr; ' + fill;
    }
    if(q.mode === 'spotpunct'){
      // "Spot the punctuation mistake" mode (the real GL Assessment
      // "Punctuation" format): a short passage split into four labelled
      // parts; exactly one part has the mistake, or none at all ("N").
      // Exactly one span in the whole block ever carries "hl-target" --
      // whichever part (or the N chip) is the actual answer -- so the
      // existing generic reveal code (which just toggles .revealed on
      // the one .hl-target span already in the DOM) works here
      // unchanged, the same as every other question mode.
      const letters = ['A', 'B', 'C', 'D'];
      const chunkHtml = q.chunks.map((chunk, idx) => {
        const letter = letters[idx];
        const isTarget = letter === q.correct;
        const cls = 'spot-chunk' + (isTarget ? ' hl-target' + (revealed ? ' revealed' : '') : '');
        return '<span class="' + cls + '"><span class="spot-tag">' + letter + '</span>' + escapeHtml(chunk) + '</span>';
      }).join(' ');
      const nIsTarget = q.correct === 'N';
      const nCls = 'spot-n-chip' + (nIsTarget ? ' hl-target' + (revealed ? ' revealed' : '') : '');
      return '<div class="spot-passage">' + chunkHtml + '</div>' +
        '<div class="' + nCls + '"><span class="spot-tag">N</span>No mistake in this line</div>';
    }
    if(q.mode === 'letterpair'){
      // Letter-pair analogy mode ("AC is to CE as FH is to ?"): two given
      // pairs establish a rule, then it's applied to a third pair. Laid out
      // as a single line ("AC is to CE as FH is to ?") that wraps onto a
      // second line only if the screen is too narrow to fit it -- this
      // keeps the whole puzzle compact instead of stacking the example
      // pair above the question pair as two separate rows.
      const fill = revealed
        ? '<span class="hl-target revealed">' + q.correct + '</span>'
        : '<span class="hl-target">?</span>';
      return '<div class="pair-analogy">' +
        '<span class="pair-box">' + q.pairA + '</span><span class="pair-link">is to</span><span class="pair-box">' + q.pairB + '</span>' +
        '<span class="pair-as">as</span>' +
        '<span class="pair-box">' + q.pairC + '</span><span class="pair-link">is to</span><span class="pair-box pair-answer">' + fill + '</span>' +
        '</div>';
    }
    // The target word is ALWAYS wrapped in a span, from the very first
    // render, whether or not it's revealed yet. This keeps the DOM
    // structure identical between the "hidden" and "revealed" states, so
    // the browser never has to recompute word-wrap positions when the
    // highlight is switched on — only a CSS class changes, not the markup.
    const tokens = q.sentence.split(' ');
    return tokens.map(tok => {
      const bare = stripPunct(tok);
      if(bare.toLowerCase() === q.correct.toLowerCase()){
        return '<span class="hl-target' + (revealed ? ' revealed' : '') + '">' + tok + '</span>';
      }
      return tok;
    }).join(' ');
  }

  function promptFor(q){
    switch(q.type){
      case 'determiner': return 'Which word is the DETERMINER?';
      case 'preposition': return 'Which word is the PREPOSITION?';
      case 'spelling': return 'Which spelling is correct?';
      case 'punctuation': return q.mode === 'spotpunct' ? 'Which part has the punctuation mistake — or is it N, no mistake?' : 'Which option is correctly punctuated?';
      case 'synonym': return 'Which word means the same as "' + q.target.toUpperCase() + '"?';
      case 'antonym': return 'Which word means the opposite of "' + q.target.toUpperCase() + '"?';
      case 'vocabulary': return 'Which word matches this meaning?';
      case 'compound': return 'Which pair joins together to make a real word?';
      case 'letterpair': return 'Which pair of letters completes the puzzle?';
      default: return 'Which word is the ' + q.type.toUpperCase() + '?';
    }
  }

  /* ---------------- REVIEW EXPLANATIONS ("the method") ---------------- */
  // Rule-based explanation generator: rather than hand-writing a bespoke
  // note for all 660+ questions, each question type gets a template that
  // reasons from the question's own data (the actual words involved), so
  // the explanation is genuinely about THIS question, not generic filler.
  const DETERMINER_WORDS = {
    a:'article', an:'article', the:'article',
    my:'possessive', your:'possessive', his:'possessive', her:'possessive',
    its:'possessive', our:'possessive', their:'possessive',
    this:'demonstrative', that:'demonstrative', these:'demonstrative', those:'demonstrative',
    some:'quantifier', any:'quantifier', many:'quantifier', much:'quantifier', few:'quantifier',
    fewer:'quantifier', several:'quantifier', each:'quantifier', every:'quantifier', both:'quantifier',
    all:'quantifier', no:'quantifier', neither:'quantifier', either:'quantifier', most:'quantifier',
    other:'quantifier', another:'quantifier', such:'quantifier', enough:'quantifier'
  };
  const DETERMINER_PHRASE = {
    article: 'which one is meant — a general one, or a specific one already known',
    possessive: 'who or what it belongs to',
    demonstrative: 'exactly which one(s) is meant — near or further away',
    quantifier: 'how many, or how much, of something there is'
  };
  const PREPOSITION_WORDS = {
    since:'time', during:'time', until:'time', before:'time', after:'time',
    under:'place', over:'place', above:'place', below:'place', behind:'place', beneath:'place',
    beside:'place', between:'place', among:'place', inside:'place', outside:'place', near:'place',
    around:'place', against:'place', opposite:'place', in:'place', on:'place', at:'place',
    to:'direction', from:'direction', into:'direction', onto:'direction', through:'direction',
    across:'direction', towards:'direction', toward:'direction', up:'direction', down:'direction', along:'direction',
    with:'other', without:'other', about:'other', of:'other', for:'other', like:'other',
    unlike:'other', despite:'other', except:'other'
  };
  const PREPOSITION_PHRASE = {
    time: 'showing WHEN something happens',
    place: 'showing WHERE something is',
    direction: 'showing the direction something moves',
    other: 'showing how it relates to the rest of the sentence, rather than a time or a place'
  };
  const CONTRACTION_MAP = {
    "we're":"we are", "you're":"you are", "they're":"they are", "i've":"i have",
    "we've":"we have", "you've":"you have", "they've":"they have", "i'll":"i will",
    "we'll":"we will", "you'll":"you will", "he'll":"he will", "she'll":"she will",
    "it's":"it is", "i'm":"i am", "he's":"he is", "she's":"she is", "that's":"that is",
    "don't":"do not", "doesn't":"does not", "didn't":"did not", "isn't":"is not",
    "aren't":"are not", "wasn't":"was not", "weren't":"were not", "can't":"cannot",
    "couldn't":"could not", "won't":"will not", "wouldn't":"would not", "shouldn't":"should not",
    "haven't":"have not", "hasn't":"has not", "hadn't":"had not", "let's":"let us",
    "who's":"who is", "there's":"there is", "could've":"could have", "should've":"should have",
    "would've":"would have", "i'd":"I would", "he'd":"he would", "she'd":"she would",
    "we'd":"we would", "they'd":"they would", "it'll":"it will", "mustn't":"must not",
    "shan't":"shall not"
  };
  const HOMOPHONE_NOTES = {
    'its': (w) => "'" + w + "' shows something belongs to 'it' — a possessive word like this never uses an apostrophe. (Only 'it's', with an apostrophe, means 'it is'.)",
    'your': (w) => "'" + w + "' shows something belongs to you — it isn't a contraction, so it has no apostrophe. ('you're', with an apostrophe, always means 'you are'.)",
    'their': (w) => "'" + w + "' shows something belongs to them — don't mix it up with 'there' (a place) or 'they're' (short for 'they are').",
    'there': (w) => "'" + w + "' points to a place — don't mix it up with 'their' (belonging to them) or 'they're' (short for 'they are').",
    'whose': (w) => "'" + w + "' shows something belongs to someone — don't mix it up with 'who's', which is short for 'who is'.",
    'were': (w) => "'" + w + "' is the past-tense verb (as in 'they were') — it isn't a contraction, so it needs no apostrophe. ('we're', with an apostrophe, means 'we are'.)",
    'lets': (w) => "'" + w + "' is the verb 'to let' (as in 'she lets him go') — different from 'let's', the contraction of 'let us'."
  };

  function findNextWord(sentence, word){
    const escaped = word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const m = sentence.match(new RegExp('\\b' + escaped + '\\b\\s+([A-Za-z]+)', 'i'));
    return m ? m[1] : null;
  }

  function explainDeterminer(a){
    const word = a.correct;
    const kind = DETERMINER_WORDS[word.toLowerCase()];
    const nextWord = findNextWord(a.sentence, word);
    const base = kind
      ? "'" + word + "' is a determiner (a " + kind + " word) — it comes right before a noun and tells us " + DETERMINER_PHRASE[kind] + "."
      : "'" + word + "' is a determiner — it sits directly in front of a noun and limits or specifies it, rather than describing it (an adjective's job), naming it (a noun), or doing an action (a verb).";
    return base + (nextWord ? " Here it points to the noun '" + nextWord + "'." : '');
  }

  function explainPreposition(a){
    const word = a.correct;
    const kind = PREPOSITION_WORDS[word.toLowerCase()] || 'other';
    return "'" + word + "' is a preposition — it links a noun or pronoun to the rest of the sentence, " + PREPOSITION_PHRASE[kind] + ". A quick test: a preposition sits just before a noun or pronoun, never before a verb.";
  }

  function diffSpelling(correct, wrong){
    let start = 0;
    while(start < correct.length && start < wrong.length && correct[start].toLowerCase() === wrong[start].toLowerCase()) start++;
    let endC = correct.length, endW = wrong.length;
    while(endC > start && endW > start && correct[endC-1].toLowerCase() === wrong[endW-1].toLowerCase()){ endC--; endW--; }
    const correctMid = correct.slice(start, endC) || '(nothing)';
    const wrongMid = wrong.slice(start, endW) || '(nothing)';
    return { correctMid, wrongMid };
  }

  function explainSpelling(a){
    const correct = a.correct;
    if(a.chosen && a.chosen.toLowerCase() !== correct.toLowerCase()){
      const d = diffSpelling(correct, a.chosen);
      let trap;
      if(d.correctMid === '(nothing)'){
        trap = "'" + a.chosen + "' has an extra '" + d.wrongMid + "' that shouldn't be there";
      } else if(d.wrongMid === '(nothing)'){
        trap = "'" + a.chosen + "' is missing the '" + d.correctMid + "' — make sure it's in there";
      } else {
        trap = "it's '" + d.correctMid + "', not '" + d.wrongMid + "' as in '" + a.chosen + "'";
      }
      return "The correct spelling is '" + correct + "'. Look closely at the tricky part: " + trap + ". Saying the word slowly, syllable by syllable, helps you catch this.";
    }
    return "The correct spelling is '" + correct + "'. Break it into syllables and say it slowly, checking for double letters, silent letters, and tricky vowel combinations.";
  }

  const SPOTPUNCT_RULE_TEXT = {
    'comma-missing': "is missing a comma — a comma belongs after an introductory phrase or clause, before a joining word like 'but', 'and' or 'so' that links two complete sentences, between items in a list, before/after a name in direct address, or around an extra bit of information dropped into the middle of a sentence",
    'comma-extra': "has a comma where none is needed — a comma shouldn't split a subject from its own verb, or sit before a word or reason that the sentence needs to make sense",
    'capital-missing': "is missing a capital letter — the very first word of a sentence, and every proper noun (a name, a place, a day, or a month), always starts with a capital letter",
    'capital-wrong': "wrongly gives a capital letter to an ordinary (common) noun — only proper nouns and the very first word of a sentence get a capital letter",
    'fullstop-missing': "actually contains two separate, complete sentences run together with no full stop between them (a 'run-on sentence') — it needs a full stop, and a new capital letter, right where the first idea ends"
  };

  function explainSpotPunct(a){
    if(a.correct === 'N' || a.errorType === 'none'){
      return "Every part here is already correctly punctuated, so there's no mistake to find — 'N' is correct. Read each part carefully, checking capital letters, commas and full stops, rather than assuming one of them must be wrong.";
    }
    const idx = ['A','B','C','D'].indexOf(a.correct);
    const original = (a.chunks && idx > -1) ? a.chunks[idx] : null;
    const rule = SPOTPUNCT_RULE_TEXT[a.errorType] || 'has a punctuation mistake';
    let text = 'Part ' + a.correct + (original ? ' ("' + original + '")' : '') + ' ' + rule + '.';
    if(a.fixText){
      text += ' It should read: "' + a.fixText + '".';
    }
    return text;
  }

  function explainPunctuation(a){
    if(a.mode === 'spotpunct') return explainSpotPunct(a);
    const correct = a.correct;
    const lower = correct.toLowerCase().trim();
    if(HOMOPHONE_NOTES[lower]) return HOMOPHONE_NOTES[lower](correct);
    if(CONTRACTION_MAP[lower]){
      return "'" + correct + "' is a contraction — an apostrophe stands in for the missing letters. '" + correct + "' is short for '" + CONTRACTION_MAP[lower] + "', so the apostrophe sits exactly where those letters were dropped.";
    }
    if(/s'$/.test(correct)){
      return "'" + correct + "' shows something belonging to more than one person or thing. Since the plural already ends in 's', just add the apostrophe AFTER it — no extra 's' needed.";
    }
    if(/'s$/.test(correct)){
      return "'" + correct + "' shows ownership — since the owner word doesn't already end in 's', add an apostrophe and then 's' to show belonging.";
    }
    return "'" + correct + "' is correct here — check whether the sentence needs to show ownership (add 's or s'), a shortened phrase (a contraction, using an apostrophe), or is just an ordinary plural that needs no apostrophe at all.";
  }

  function explainVocabulary(a){
    return "'" + a.correct + "' is the word that matches this meaning: \"" + a.sentence + "\". Learning the definition itself is the fastest way to spot the right word next time.";
  }

  function explainRelated(a){
    const isAntonym = a.type === 'antonym';
    const relation = isAntonym ? 'the opposite of' : '(almost) the same as';
    let text = "'" + a.correct + "' means " + relation + " '" + a.target + "' in this sentence.";
    if(a.chosen && a.chosen.toLowerCase() !== a.correct.toLowerCase()){
      text += " '" + a.chosen + "' doesn't fit — try swapping each option into the sentence in place of '" + a.target + "' and see which one keeps " + (isAntonym ? "the sentence's meaning reversed" : "the sentence meaning the same") + ".";
    } else {
      text += " A good check: swap the word into the sentence in place of '" + a.target + "' and see if it still makes sense" + (isAntonym ? ' with the opposite meaning' : '') + ".";
    }
    return text;
  }

  function explainCompound(a){
    const parts = a.correct.split(' + ');
    if(parts.length === 2){
      const joined = parts[0] + parts[1];
      return "'" + parts[0] + "' and '" + parts[1] + "' are both real words on their own — read straight together with no space, they spell another real, everyday word: '" + joined + "'. Try saying each pair of options out loud, one right after the other, to hear whether it forms an actual word.";
    }
    return "Joining these two real words directly together spells another real word — say each pair out loud, one after another, to check.";
  }

  // Letter-pair analogy ("AC is to CE as FH is to ?"): the rule is always a
  // fixed alphabet shift applied to each letter position (the two positions
  // can shift by different amounts, and can wrap past Z back to A) — so the
  // explanation is derived arithmetically from the given pair, not
  // hand-written per question.
  function letterPos(ch){ return ch.toUpperCase().charCodeAt(0) - 64; } // A=1 .. Z=26
  function shiftLetter(ch, shift){
    let p = letterPos(ch) - 1; // 0-based
    p = ((p + shift) % 26 + 26) % 26;
    return String.fromCharCode(65 + p);
  }
  function letterShiftAmount(fromCh, toCh){
    let diff = (letterPos(toCh) - letterPos(fromCh) + 26) % 26; // 0..25
    if(diff > 13) diff = diff - 26; // prefer the smaller-magnitude signed shift
    return diff;
  }
  function fmtShift(s){ return s >= 0 ? ('+' + s) : String(s); }
  // "Mirror" rule: each letter swaps for its reflection at the opposite end
  // of the alphabet (A<->Z, B<->Y, ... M<->N in the middle) — the two
  // positions always add up to 27. This is NOT a constant shift (the amount
  // needed differs for every letter), which is exactly what makes it a
  // harder, separately-recognised GL Assessment "Letter Connections" trick.
  function mirrorLetter(ch){ return String.fromCharCode(64 + (27 - letterPos(ch))); }
  function isMirrorPair(fromCh, toCh){ return (letterPos(fromCh) + letterPos(toCh)) === 27; }

  function explainLetterPair(a){
    const a1 = a.pairA[0], a2 = a.pairA[1];
    const b1 = a.pairB[0], b2 = a.pairB[1];
    const c1 = a.pairC[0], c2 = a.pairC[1];

    if(isMirrorPair(a1, b1) && isMirrorPair(a2, b2)){
      const r1 = mirrorLetter(c1), r2 = mirrorLetter(c2);
      return "This one uses the 'mirror' trick, not a simple shift: each letter swaps for its reflection at the opposite end of the alphabet — A pairs with Z, B with Y, C with X, and so on all the way to M with N in the middle (the two positions always add up to 27). '" + a1 + "' mirrors to '" + b1 + "', and '" + a2 + "' mirrors to '" + b2 + "'. Apply the same mirror to '" + a.pairC + "': '" + c1 + "' mirrors to '" + r1 + "', and '" + c2 + "' mirrors to '" + r2 + "', giving '" + a.correct + "'. (A common trap here is assuming it's a constant shift like the easier puzzles — check the mirror rule whenever a shift doesn't seem to fit both letters.)";
    }

    const shift1 = letterShiftAmount(a1, b1);
    const shift2 = letterShiftAmount(a2, b2);
    const r1 = shiftLetter(c1, shift1);
    const r2 = shiftLetter(c2, shift2);
    let rule;
    if(shift1 === shift2){
      rule = "Compare '" + a.pairA + "' with '" + a.pairB + "': both letters move " + fmtShift(shift1) + " through the alphabet (" + a1 + '→' + b1 + ", " + a2 + '→' + b2 + ").";
    } else if(shift2 === 0){
      rule = "Compare '" + a.pairA + "' with '" + a.pairB + "': the first letter moves " + fmtShift(shift1) + " (" + a1 + '→' + b1 + "), and the second letter stays exactly the same (" + a2 + '→' + b2 + ").";
    } else if(shift1 === 0){
      rule = "Compare '" + a.pairA + "' with '" + a.pairB + "': the first letter stays exactly the same (" + a1 + '→' + b1 + "), and the second letter moves " + fmtShift(shift2) + " (" + a2 + '→' + b2 + ").";
    } else {
      rule = "Compare '" + a.pairA + "' with '" + a.pairB + "': the first letter moves " + fmtShift(shift1) + " (" + a1 + '→' + b1 + "), and the second letter moves " + fmtShift(shift2) + " (" + a2 + '→' + b2 + ") — a different shift for each position.";
    }
    return rule + " Apply the same shifts to '" + a.pairC + "': " + c1 + ' ' + fmtShift(shift1) + ' → ' + r1 + ", and " + c2 + ' ' + fmtShift(shift2) + ' → ' + r2 + ", giving '" + a.correct + "'.";
  }

  function explainAnswer(a){
    switch(a.type){
      case 'determiner': return explainDeterminer(a);
      case 'preposition': return explainPreposition(a);
      case 'spelling': return explainSpelling(a);
      case 'punctuation': return explainPunctuation(a);
      case 'vocabulary': return explainVocabulary(a);
      case 'synonym': case 'antonym': return explainRelated(a);
      case 'compound': return explainCompound(a);
      case 'letterpair': return explainLetterPair(a);
      default: return "The correct answer is '" + a.correct + "'.";
    }
  }

  /* ---------------- ALPHABET REFERENCE STRIP (Letter Pair Puzzles tool) --
     A-Z on one line, shown only while a Letter Pair Puzzle is on screen.
     Hovering a letter highlights its mirror partner (A<->Z, ... M<->N);
     clicking two letters in turn draws an arc between them labelled with
     the gap and direction (e.g. "3R" for A then D, "3L" for D then A).
     Arcs alternate stacking above/below the letter row (and stack further
     out, lane by lane, whenever two arcs would otherwise overlap) so a
     new arc never obscures an older one or its label. While the first
     letter of a pair is selected, hovering a candidate second letter
     draws a live dashed preview arc with a running distance count. --- */
  const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
  const AB_ARC_COLORS = ['#ffd23f','#4ecdc4','#ff6b6b','#5b9df9','#5fd48a','#b388ff'];
  const AB_ROW_H = 26;       // must match .ab-letter height
  const AB_ARC_BASE_GAP = 24;  // distance from the row edge to the first lane's peak
  const AB_ARC_LANE_PITCH = 26; // extra distance per additional stacked lane
  const AB_ARC_EDGE_PAD = 18;   // headroom left beyond the outer-most lane for its label
  const AB_ARC_NO_ARC_PAD = 18; // padding used on a side with no arcs at all
  let abClickBuffer = [];
  let abArcs = []; // {i1, i2, label, side:'above'|'below', color}
  let abPreviewArc = null; // same shape, transient, shown while hovering the 2nd letter
  let abPadTop = AB_ARC_NO_ARC_PAD; // current reserved space above/below the row --
  let abPadBottom = AB_ARC_NO_ARC_PAD; // only changed on click, never mid-hover (see below)

  function buildAlphabetStrip(){
    const row = el('ab-row');
    if(row.children.length) return; // build once, reused across questions
    row.innerHTML = ALPHABET.map((ch, i) =>
      '<span class="ab-letter" data-i="' + i + '">' + ch + '</span>'
    ).join('');
  }

  function abMirrorIndex(i){ return 25 - i; } // 0-based: A(0)<->Z(25), ..., M(12)<->N(13)

  function abSetHover(i, on){
    const letters = el('ab-row').children;
    const mIdx = abMirrorIndex(i);
    if(letters[mIdx]) letters[mIdx].classList.toggle('ab-mirror-hint', on);
  }

  function abDistanceLabel(from, to){
    const diff = to - from;
    return Math.abs(diff) + (diff > 0 ? 'R' : 'L');
  }

  // Pure layout pass (no DOM writes): places a list of arcs into lanes,
  // bumping an arc to the next lane out on its side whenever its
  // horizontal span overlaps an arc already placed there.
  function computeAbLanes(arcs){
    const letters = el('ab-row').children;
    const lanesAbove = [];
    const lanesBelow = [];
    const OVERLAP_PAD = 8;
    const placements = [];
    arcs.forEach((arc) => {
      const elA = letters[arc.i1], elB = letters[arc.i2];
      if(!elA || !elB) return;
      const xA = elA.offsetLeft + elA.offsetWidth / 2;
      const xB = elB.offsetLeft + elB.offsetWidth / 2;
      const x1 = Math.min(xA, xB), x2 = Math.max(xA, xB);
      const lanes = arc.side === 'below' ? lanesBelow : lanesAbove;
      let lane = 0;
      while(lanes[lane] && lanes[lane].some((iv) => !(x2 + OVERLAP_PAD < iv.x1 || x1 - OVERLAP_PAD > iv.x2))){
        lane++;
      }
      if(!lanes[lane]) lanes[lane] = [];
      lanes[lane].push({ x1: x1, x2: x2 });
      placements.push({ arc: arc, xA: xA, xB: xB, lane: lane });
    });
    return { lanesAbove: lanesAbove, lanesBelow: lanesBelow, placements: placements };
  }

  // Sets how much room is reserved above/below the row, based on the
  // COMMITTED arcs only -- plus one extra lane on whichever side is passed
  // as reserveSide, to make room for a not-yet-drawn hover preview. This
  // is the only place that resizes the strip, and it only runs on a real
  // click (start/finish a pair) or Clear -- never during mouse movement,
  // which is what made the live preview feel jerky (the box was resizing
  // on every hovered letter, flickering the scrollbars along with it).
  function applyAbPadding(reserveSide){
    const committed = computeAbLanes(abArcs);
    let aboveLanes = committed.lanesAbove.length;
    let belowLanes = committed.lanesBelow.length;
    if(reserveSide === 'above') aboveLanes += 1;
    if(reserveSide === 'below') belowLanes += 1;
    abPadTop = aboveLanes ? AB_ARC_BASE_GAP + (aboveLanes - 1) * AB_ARC_LANE_PITCH + AB_ARC_EDGE_PAD : AB_ARC_NO_ARC_PAD;
    abPadBottom = belowLanes ? AB_ARC_BASE_GAP + (belowLanes - 1) * AB_ARC_LANE_PITCH + AB_ARC_EDGE_PAD : AB_ARC_NO_ARC_PAD;
    el('ab-scroll').style.paddingTop = abPadTop + 'px';
    el('ab-scroll').style.paddingBottom = abPadBottom + 'px';
  }

  // Pure redraw: uses whatever abPadTop/abPadBottom is already set (see
  // applyAbPadding above) and never itself touches the strip's size, so
  // calling this on every mouse-move for the live preview is cheap and
  // doesn't reflow or resize anything.
  function renderAbArcs(){
    const svg = el('ab-arcs');
    const row = el('ab-row');
    const rowWidth = Math.max(row.scrollWidth, 1);
    const allArcs = abPreviewArc ? abArcs.concat([abPreviewArc]) : abArcs;
    const placed = computeAbLanes(allArcs).placements;

    const rowTop = abPadTop;
    const rowBottom = abPadTop + AB_ROW_H;
    const totalHeight = abPadTop + AB_ROW_H + abPadBottom;
    svg.setAttribute('width', rowWidth);
    svg.setAttribute('height', totalHeight);
    svg.setAttribute('viewBox', '0 0 ' + rowWidth + ' ' + totalHeight);

    let html = '';
    placed.forEach((p) => {
      const arc = p.arc;
      const isPreview = arc === abPreviewArc;
      const side = arc.side === 'below' ? 'below' : 'above';
      const peakDist = AB_ARC_BASE_GAP + p.lane * AB_ARC_LANE_PITCH;
      const baseY = side === 'above' ? rowTop : rowBottom;
      const peakY = side === 'above' ? baseY - peakDist : baseY + peakDist;
      const midX = (p.xA + p.xB) / 2;
      const labelY = side === 'above' ? peakY - 6 : peakY + 15;
      const color = arc.color || AB_ARC_COLORS[0];
      const style = isPreview ? ' style="opacity:.6"' : '';
      const dash = isPreview ? ' stroke-dasharray="5,4"' : '';
      html += '<path class="ab-arc-path" d="M' + p.xA + ',' + baseY + ' Q' + midX + ',' + peakY + ' ' + p.xB + ',' + baseY + '" stroke="' + color + '"' + dash + style + '></path>';
      html += '<text class="ab-arc-label" x="' + midX + '" y="' + labelY + '" text-anchor="middle" fill="' + color + '"' + style + '>' + arc.label + '</text>';
    });
    svg.innerHTML = html;
  }

  function abHandleClick(i){
    const letters = el('ab-row').children;
    abPreviewArc = null;
    if(abClickBuffer.length === 0){
      abClickBuffer.push(i);
      letters[i].classList.add('ab-selected');
      // Reserve room on whichever side the pending preview would land on,
      // fixed for the whole time this letter stays selected -- so hovering
      // candidates afterwards never needs to resize the strip.
      const side = abArcs.length % 2 === 0 ? 'above' : 'below';
      applyAbPadding(side);
      renderAbArcs();
      return;
    }
    const first = abClickBuffer[0];
    letters[first].classList.remove('ab-selected');
    abClickBuffer = [];
    if(first !== i){ // same letter clicked twice is a reset, with no new arc
      const side = abArcs.length % 2 === 0 ? 'above' : 'below';
      const color = AB_ARC_COLORS[abArcs.length % AB_ARC_COLORS.length];
      abArcs.push({ i1: first, i2: i, label: abDistanceLabel(first, i), side: side, color: color });
    }
    applyAbPadding(null); // no pending preview any more -- size to committed arcs only
    renderAbArcs();
  }

  // While one letter is already selected, live-preview the arc to whatever
  // letter the mouse is currently over -- it commits for real on the click.
  // This never calls applyAbPadding: the space for it was already reserved
  // the moment the first letter was clicked, so re-rendering on hover is
  // just a cheap redraw, not a resize.
  function abHandleHoverIn(i){
    abSetHover(i, true);
    if(abClickBuffer.length === 1){
      const first = abClickBuffer[0];
      if(i !== first){
        const side = abArcs.length % 2 === 0 ? 'above' : 'below';
        const color = AB_ARC_COLORS[abArcs.length % AB_ARC_COLORS.length];
        abPreviewArc = { i1: first, i2: i, label: abDistanceLabel(first, i), side: side, color: color };
      } else {
        abPreviewArc = null;
      }
      renderAbArcs();
    }
  }

  function abHandleHoverOut(i){
    abSetHover(i, false);
    if(abPreviewArc && abPreviewArc.i2 === i){
      abPreviewArc = null;
      renderAbArcs();
    }
  }

  function clearAlphabetAnnotations(){
    abArcs = [];
    abClickBuffer = [];
    abPreviewArc = null;
    Array.from(el('ab-row').children).forEach(l => l.classList.remove('ab-selected'));
    applyAbPadding(null);
    renderAbArcs();
  }

  function updateAlphabetStripVisibility(q){
    const strip = el('alphabet-strip');
    const show = !!q && q.type === 'letterpair';
    strip.classList.toggle('hidden', !show);
    if(show) clearAlphabetAnnotations(); // fresh reference for each new puzzle
  }

  /* ---------------- QUESTION-TYPE PREVIEW (👁 Example button) ---------------- */
  // Shows one fully-answered, non-interactive sample question per type in
  // the currently selected mission, so a pilot can see the format before
  // committing to START MISSION.
  function typesForExampleCategory(cat){
    return CATEGORY_TYPES[cat] || ["determiner","preposition","spelling","punctuation","synonym","antonym","vocabulary","compound","letterpair"];
  }

  function findExampleByType(type){
    return QUESTIONS.find(q => q.type === type);
  }

  function renderExampleBlock(q){
    const promptHtml = escapeHtml(promptFor(q));
    const sentenceHtml = renderSentence(q, true);
    const optsHtml = q.options.map(opt => {
      const isCorrect = opt.toLowerCase() === q.correct.toLowerCase();
      return '<div class="example-opt' + (isCorrect ? ' correct' : '') + '">' + escapeHtml(opt) + (isCorrect ? ' ✓ correct answer' : '') + '</div>';
    }).join('');
    return '<div class="example-block">' +
      '<div class="prompt">' + promptHtml + '</div>' +
      '<div class="sentence">' + sentenceHtml + '</div>' +
      '<div class="example-opts">' + optsHtml + '</div>' +
    '</div>';
  }

  function showExampleModal(category){
    const types = typesForExampleCategory(category);
    const html = types.map(t => {
      const q = findExampleByType(t);
      return q ? renderExampleBlock(q) : '';
    }).join('<hr class="example-divider">');
    el('example-modal-content').innerHTML = html || '<p>No example available.</p>';
    el('example-modal-backdrop').classList.remove('hidden');
  }

  function timeLeft(){
    return GAME_SECONDS - (Date.now() - startTime) / 1000;
  }

  /* ---------------- SPEED ROUND: the bird IS the timer ---------------- */
  // Instead of a hidden countdown checked only between questions (classic
  // mode), Speed Round needs a live, continuously-ticking clock: the bird's
  // height on screen falls in real time even while the player is still
  // thinking, and a correct/wrong answer nudges the underlying time up or
  // down. That means it needs its own requestAnimationFrame loop, separate
  // from the classic timeLeft()/startTime mechanism above.
  function updateBirdPosition(){
    const sky = el('speed-sky');
    const bird = el('speed-bird');
    if(!sky || !bird) return;
    const ratio = Math.max(0, Math.min(1, speedTimeLeft / SPEED_ROUND_SECONDS));
    const groundH = 14, birdH = 30;
    const travel = Math.max(0, sky.clientHeight - groundH - birdH);
    bird.style.bottom = (groundH + ratio * travel) + 'px';
  }

  function crashBird(){
    if(speedCrashed) return;
    speedCrashed = true;
    stopSpeedTicker();
    const bird = el('speed-bird');
    if(bird){
      bird.style.bottom = '14px';
      bird.classList.add('crashed');
    }
    const sky = el('speed-sky');
    if(sky) sky.classList.add('speed-frozen'); // freeze the scrolling scenery too
    try{ playGentleWrong(); }catch(e){}
    setTimeout(() => { endGame(); }, 700);
  }

  function stopSpeedTicker(){
    if(speedTickHandle !== null){
      cancelAnimationFrame(speedTickHandle);
      speedTickHandle = null;
    }
  }

  function speedTick(now){
    if(gameMode !== 'speed' || screenGame.classList.contains('hidden') || isPaused){
      speedTickHandle = null;
      return;
    }
    const dt = (now - speedLastTick) / 1000;
    speedLastTick = now;
    speedTimeLeft -= dt;
    updateBirdPosition();
    // Distance flown ticks up every frame purely from time in the air (the
    // bird's forward speed never changes), and quietly banks bonus score as
    // whole points accumulate -- so a longer, steadier flight earns more
    // even between correct answers, on top of the per-question points.
    speedDistance += dt * SPEED_METRES_PER_SEC;
    speedDistanceScoreAcc += dt * SPEED_METRES_PER_SEC * SPEED_POINTS_PER_METRE;
    const wholePoints = Math.floor(speedDistanceScoreAcc);
    if(wholePoints > 0){
      speedDistanceScoreAcc -= wholePoints;
      score += wholePoints;
      updateScoreDisplay(false); // a quiet tick-up, not the big "correct answer" bump
    }
    if(speedTimeLeft <= 0){
      crashBird();
      return;
    }
    speedTickHandle = requestAnimationFrame(speedTick);
  }

  function startSpeedTicker(){
    stopSpeedTicker();
    speedTimeLeft = SPEED_ROUND_SECONDS;
    speedCrashed = false;
    speedDistance = 0;
    speedDistanceScoreAcc = 0;
    const bird = el('speed-bird');
    if(bird) bird.classList.remove('crashed');
    const sky = el('speed-sky');
    if(sky) sky.classList.remove('speed-frozen');
    updateBirdPosition();
    speedLastTick = performance.now();
    speedTickHandle = requestAnimationFrame(speedTick);
  }

  // Restarts the live ticker from wherever speedTimeLeft currently sits,
  // WITHOUT resetting it to SPEED_ROUND_SECONDS -- used to un-pause.
  function resumeSpeedTicker(){
    stopSpeedTicker();
    speedLastTick = performance.now();
    speedTickHandle = requestAnimationFrame(speedTick);
  }

  function bumpBird(deltaSeconds){
    // Returns true if this delta crashed the bird (game over), so callers
    // can skip UI that assumes the round is still going.
    if(gameMode !== 'speed') return false;
    speedTimeLeft += deltaSeconds;
    updateBirdPosition();
    const bird = el('speed-bird');
    if(bird){
      const cls = deltaSeconds > 0 ? 'boost' : 'drop';
      bird.classList.remove('boost','drop');
      // Force reflow so re-adding the same class restarts its animation.
      void bird.offsetWidth;
      bird.classList.add(cls);
      setTimeout(() => bird.classList.remove(cls), 400);
    }
    if(speedTimeLeft <= 0){
      crashBird();
      return true;
    }
    return false;
  }

  /* ---------------- PAUSE ---------------- */
  // Exit Mission and the Pause toggle both live OUTSIDE #game-content, so
  // they stay reachable no matter what's happening underneath; the overlay
  // itself only covers the question/options area (and, incidentally, the
  // tracing paper, which is exactly the "everything freezes" behaviour we
  // want).
  function pauseGame(){
    if(isPaused || screenGame.classList.contains('hidden')) return;
    isPaused = true;
    pausedAt = Date.now();
    if(gameMode === 'speed'){
      stopSpeedTicker(); // leaves speedTimeLeft frozen exactly where it was
      const sky = el('speed-sky');
      if(sky) sky.classList.add('speed-frozen'); // freeze the scrolling scenery too
    }
    if(pendingNextTimeout !== null){
      clearTimeout(pendingNextTimeout);
      pendingNextTimeout = null;
      pausedPendingNext = true;
    }
    el('pause-overlay').classList.remove('hidden');
    const btn = el('btn-pause');
    btn.textContent = '▶ Resume';
    btn.classList.add('paused');
  }

  function resumeGame(){
    if(!isPaused) return;
    isPaused = false;
    const pauseDurationMs = Date.now() - pausedAt;
    if(gameMode === 'classic'){
      // Shift the game's clock forward by exactly how long we were paused,
      // so the hidden 300s countdown (and this question's own elapsed-time
      // stat) doesn't lose that time.
      startTime += pauseDurationMs;
      questionStartTime += pauseDurationMs;
    } else if(gameMode === 'speed'){
      resumeSpeedTicker(); // restarts the rAF loop from the frozen speedTimeLeft
      const sky = el('speed-sky');
      if(sky) sky.classList.remove('speed-frozen');
    }
    el('pause-overlay').classList.add('hidden');
    const btn = el('btn-pause');
    btn.textContent = '⏸ Pause';
    btn.classList.remove('paused');
    if(pausedPendingNext){
      pausedPendingNext = false;
      showNextQuestion();
    }
  }

  function togglePause(){
    if(isPaused) resumeGame(); else pauseGame();
  }

  function resetPauseState(){
    isPaused = false;
    pausedPendingNext = false;
    el('pause-overlay').classList.add('hidden');
    const btn = el('btn-pause');
    btn.textContent = '⏸ Pause';
    btn.classList.remove('paused');
  }

  /* ---------------- TRACING PAPER ---------------- */
  // A slide-in scratch-paper overlay a pilot can draw on with mouse, touch
  // or pen (Pointer Events unify all three) -- for rough workings, without
  // leaving the question. A fresh sheet is given each question, like real
  // exam scratch paper. Two tools: Pencil (freehand) and Ruler (drags out
  // a perfectly straight line, like laying a real ruler down and tracing
  // its edge) -- a visible ruler bar follows the drag for the metaphor.
  let tracingDrawing = false;
  let tracingTool = 'pencil'; // 'pencil' | 'ruler' | 'eraser'
  let rulerStart = null;
  let rulerSnapshot = null; // ImageData captured the instant a ruler-drag begins
  const PENCIL_LINE_WIDTH = 2.5;
  const ERASER_LINE_WIDTH = 18;

  function setTracingTool(tool){
    tracingTool = tool;
    el('btn-tool-pencil').classList.toggle('active', tool === 'pencil');
    el('btn-tool-ruler').classList.toggle('active', tool === 'ruler');
    el('btn-tool-eraser').classList.toggle('active', tool === 'eraser');
  }

  function resizeTracingCanvas(){
    const canvas = el('tracing-canvas');
    if(!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const w = Math.max(1, Math.round(rect.width));
    const h = Math.max(1, Math.round(rect.height));
    if(canvas.width === w && canvas.height === h) return;
    // Preserve whatever's already drawn across the resize instead of
    // silently wiping it (canvas.width/height resets the bitmap).
    const hadContent = canvas.width > 0 && canvas.height > 0;
    const prevUrl = hadContent ? canvas.toDataURL() : null;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.strokeStyle = '#33302a';
    ctx.lineWidth = PENCIL_LINE_WIDTH;
    if(prevUrl){
      const img = new Image();
      img.onload = () => ctx.drawImage(img, 0, 0, w, h);
      img.src = prevUrl;
    }
  }

  function tracingPos(e){
    const canvas = el('tracing-canvas');
    const rect = canvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  }

  function showRulerOverlay(start, end){
    el('ruler-overlay').classList.remove('hidden');
    updateRulerOverlay(start, end);
  }

  function updateRulerOverlay(start, end){
    const overlay = el('ruler-overlay');
    const dx = end.x - start.x, dy = end.y - start.y;
    const dist = Math.sqrt(dx*dx + dy*dy);
    const angle = Math.atan2(dy, dx) * 180 / Math.PI;
    overlay.style.width = Math.max(dist, 2) + 'px';
    overlay.style.transform = 'translate(' + start.x + 'px,' + (start.y - 13) + 'px) rotate(' + angle + 'deg)';
  }

  function hideRulerOverlay(){
    el('ruler-overlay').classList.add('hidden');
  }

  function redrawRulerPreview(start, end){
    const canvas = el('tracing-canvas');
    const ctx = canvas.getContext('2d');
    if(!rulerSnapshot) return;
    // Restore the pixels from BEFORE this drag started, then draw the
    // straight candidate line on top -- so dragging the ruler around
    // previews the line live without leaving a trail behind it.
    ctx.putImageData(rulerSnapshot, 0, 0);
    ctx.beginPath();
    ctx.moveTo(start.x, start.y);
    ctx.lineTo(end.x, end.y);
    ctx.stroke();
  }

  function tracingStart(e){
    if(!el('tracing-paper').classList.contains('open')) return;
    tracingDrawing = true;
    const canvas = el('tracing-canvas');
    const ctx = canvas.getContext('2d');
    const p = tracingPos(e);
    if(tracingTool === 'ruler'){
      ctx.globalCompositeOperation = 'source-over';
      ctx.lineWidth = PENCIL_LINE_WIDTH;
      rulerStart = p;
      rulerSnapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);
      showRulerOverlay(p, p);
    } else if(tracingTool === 'eraser'){
      // The canvas itself is transparent -- the paper's translucent look
      // comes from the CSS behind it -- so "destination-out" rubs pixels
      // back to transparent, correctly revealing the paper underneath.
      ctx.globalCompositeOperation = 'destination-out';
      ctx.lineWidth = ERASER_LINE_WIDTH;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    } else {
      ctx.globalCompositeOperation = 'source-over';
      ctx.lineWidth = PENCIL_LINE_WIDTH;
      ctx.beginPath();
      ctx.moveTo(p.x, p.y);
    }
    e.preventDefault();
  }

  function tracingMove(e){
    if(!tracingDrawing) return;
    const p = tracingPos(e);
    if(tracingTool === 'ruler'){
      updateRulerOverlay(rulerStart, p);
      redrawRulerPreview(rulerStart, p);
    } else {
      const ctx = el('tracing-canvas').getContext('2d');
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
    }
    e.preventDefault();
  }

  function tracingEnd(){
    if(tracingTool === 'ruler'){
      hideRulerOverlay();
      rulerStart = null;
      rulerSnapshot = null;
    }
    const ctx = el('tracing-canvas').getContext('2d');
    ctx.globalCompositeOperation = 'source-over';
    tracingDrawing = false;
  }

  function clearTracingCanvas(){
    const canvas = el('tracing-canvas');
    if(canvas.width && canvas.height){
      canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
    }
  }

  // A brand-new sheet (new question / new game) also resets the tool back
  // to pencil. Wiping the sheet mid-question with the Clear button should
  // NOT silently switch the tool the child had selected, so that's kept
  // separate from clearTracingCanvas() above.
  function freshTracingSheet(){
    clearTracingCanvas();
    setTracingTool('pencil');
  }

  function closeTracingPaper(){
    el('tracing-paper').classList.remove('open');
    el('btn-tracing-toggle').textContent = '✏️◀';
    hideRulerOverlay();
  }

  function toggleTracingPaper(){
    const paper = el('tracing-paper');
    const isOpen = paper.classList.toggle('open');
    el('btn-tracing-toggle').textContent = isOpen ? '✏️▶' : '✏️◀';
    if(isOpen) requestAnimationFrame(resizeTracingCanvas);
  }

  function escapeHtml(s){
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function recordMistake(q, chosenWord){
    const player = getOrCreatePlayer(playerName);
    if(!player) return;
    const qid = questionId(q);
    const rec = player.mistakes[qid] || {
      type: q.type, mode: q.mode, sentence: q.sentence, target: q.target, correct: q.correct,
      pairA: q.pairA, pairB: q.pairB, pairC: q.pairC,
      chunks: q.chunks, errorType: q.errorType, fixText: q.fixText, timesWrong: 0
    };
    rec.timesWrong += 1;
    rec.lastChosen = chosenWord;
    rec.lastTs = Date.now();
    player.mistakes[qid] = rec;
    savePlayers();
  }

  /* ---------------- GAME FLOW ---------------- */
  function saveIconForCurrentPlayer(){
    const player = getOrCreatePlayer(playerName);
    if(player){
      player.icon = iconOverride || player.icon || defaultIconFor(player.name);
      savePlayers();
    }
    iconOverride = null;
    return player ? player.icon : defaultIconFor(playerName);
  }

  function startGame(){
    score = 0;
    streak = 0;
    answered = [];
    refillQueue();
    startTime = Date.now();
    updateScoreDisplay(false);
    updateStreakDisplay();
    const icon = saveIconForCurrentPlayer();
    el('hud-player-name').textContent = icon + ' ' + playerName;
    stopSpeedTicker(); // defensive: cancel any leftover loop from a previous round
    resetPauseState(); // defensive: clear any stale pause from a previous round
    closeTracingPaper();
    freshTracingSheet();
    if(gameMode === 'speed'){
      el('speed-sky').classList.remove('hidden');
      showScreen(screenGame);
      startSpeedTicker();
    } else {
      el('speed-sky').classList.add('hidden');
      showScreen(screenGame);
    }
    showNextQuestion();
  }

  function showNextQuestion(){
    // Classic mode ends via this hidden 300s check between questions; Speed
    // Round ends the instant its live ticker crashes the bird (crashBird()
    // calls endGame() directly), so it must never also be judged here.
    if(gameMode === 'classic' && timeLeft() <= 0){
      endGame();
      return;
    }
    awaitingContinue = false;
    el('continue-hint').classList.add('hidden');
    closeTracingPaper(); // fresh scratch paper each question, like a real exam
    freshTracingSheet();
    current = nextQuestionData();
    currentOptions = shuffle(current.options);
    updateAlphabetStripVisibility(current);
    el('prompt-text').textContent = promptFor(current);
    el('sentence-display').innerHTML = renderSentence(current, false);
    const grid = el('options-grid');
    grid.innerHTML = '';
    currentOptions.forEach((word, idx) => {
      const btn = document.createElement('button');
      btn.className = 'opt-btn';
      btn.innerHTML = '<span class="opt-num">' + (idx+1) + '</span><span>' + escapeHtml(word) + '</span>';
      btn.addEventListener('click', () => selectAnswer(idx));
      grid.appendChild(btn);
    });
    questionStartTime = Date.now();
  }

  function updateScoreDisplay(bump){
    const sv = el('score-value');
    sv.textContent = score;
    if(bump){
      sv.classList.remove('bump');
      void sv.offsetWidth;
      sv.classList.add('bump');
    }
  }

  function updateStreakDisplay(){
    const box = el('streak-box');
    if(streak >= 2){
      box.textContent = '🔥'.repeat(Math.min(streak,3)) + (streak > 3 ? ' x' + streak : '');
    } else {
      box.textContent = '';
    }
  }

  function selectAnswer(idx){
    if(awaitingContinue) return;
    const chosenWord = currentOptions[idx];
    const isCorrect = chosenWord.toLowerCase() === current.correct.toLowerCase();
    const timeMs = Date.now() - questionStartTime;

    answered.push({
      type: current.type,
      mode: current.mode,
      sentence: current.sentence,
      target: current.target,
      correct: current.correct,
      pairA: current.pairA,
      pairB: current.pairB,
      pairC: current.pairC,
      chunks: current.chunks,
      errorType: current.errorType,
      fixText: current.fixText,
      chosen: chosenWord,
      isCorrect: isCorrect,
      timeMs: timeMs
    });

    const buttons = el('options-grid').querySelectorAll('.opt-btn');
    buttons.forEach(b => b.disabled = true);

    if(isCorrect){
      streak += 1;
      score += 10 + Math.min(streak-1, 5) * 2;
      updateScoreDisplay(true);
      updateStreakDisplay();
      try{ playCorrect(); }catch(e){}
      buttons[idx].classList.add('correct');
      bumpBird(3); // Speed Round: correct answers buy back 3 seconds of altitude
      pendingNextTimeout = setTimeout(() => {
        pendingNextTimeout = null;
        showNextQuestion();
      }, 550);
    } else {
      streak = 0;
      updateStreakDisplay();
      try{ playGentleWrong(); }catch(e){}
      recordMistake(current, chosenWord);
      buttons[idx].classList.add('wrong');
      const correctIdx = currentOptions.findIndex(w => w.toLowerCase() === current.correct.toLowerCase());
      buttons[correctIdx].classList.add('correct');
      // Reveal by toggling a class on the already-present target span —
      // never rebuild the sentence markup here, so nothing can reflow.
      // "related" mode (synonym/antonym) already shows its given word
      // highlighted from the start, so there's nothing to reveal there.
      if(current.mode !== 'related'){
        const targetSpan = el('sentence-display').querySelector('.hl-target');
        if(targetSpan){
          if(current.mode === 'blank' || current.mode === 'define' || current.mode === 'compound'){ targetSpan.textContent = current.correct; }
          targetSpan.classList.add('revealed');
        }
      }
      // Speed Round: a wrong answer costs 2 seconds of altitude, which can
      // itself crash the bird — if so, skip the "press space to continue"
      // flow entirely since the round is already ending on its own.
      const crashed = bumpBird(-2);
      if(!crashed){
        awaitingContinue = true;
        el('continue-hint').classList.remove('hidden');
      }
    }
  }

  function handleContinue(){
    if(!awaitingContinue) return;
    awaitingContinue = false;
    showNextQuestion();
  }

  function endGame(){
    stopSpeedTicker(); // defensive: make sure the bird loop can't outlive the round
    resetPauseState(); // defensive: never leave a paused HUD state behind
    el('btn-review').classList.remove('hidden'); // addition rounds hide this; restore it for normal rounds
    try{ playFinishTune(); }catch(e){}
    const total = answered.length;
    const correctCount = answered.filter(a => a.isCorrect).length;
    const accuracy = total ? Math.round((correctCount/total)*100) : 0;
    const avgMs = total ? answered.reduce((s,a)=>s+a.timeMs,0)/total : 0;

    el('res-correct').textContent = correctCount + ' / ' + total;
    el('res-accuracy').textContent = accuracy + '%';
    el('res-avgtime').textContent = (avgMs/1000).toFixed(1) + 's';

    const distanceStat = el('res-distance-stat');
    if(gameMode === 'speed'){
      el('res-distance').textContent = Math.round(speedDistance) + 'm';
      distanceStat.classList.remove('hidden');
    } else {
      distanceStat.classList.add('hidden');
    }

    let msg = 'Great effort!';
    if(accuracy >= 90) msg = '🌟 Outstanding — top marks!';
    else if(accuracy >= 75) msg = '💪 Really strong work!';
    else if(accuracy >= 50) msg = '👍 Good progress — keep practising!';
    else msg = '🔧 Nice try — let’s review a few together.';
    el('results-message').textContent = msg;

    leaderboard.push({
      name: playerName,
      score: score,
      correct: correctCount,
      total: total,
      accuracy: accuracy,
      avgMs: avgMs,
      category: selectedCategory,
      ts: Date.now()
    });
    saveLeaderboard();

    const player = getOrCreatePlayer(playerName);
    if(player){ player.gamesPlayed = (player.gamesPlayed || 0) + 1; savePlayers(); }
    renderPilotDatalist();

    el('same-name-label').textContent = playerName;
    el('new-name-field').classList.add('hidden');
    el('new-name-confirm-row').classList.add('hidden');
    el('new-name-input').value = '';
    el('new-name-recognition').textContent = '';

    showScreen(screenResults);
  }

  /* ---------------- ADDITION ALLEY (column-addition money word problems) ---------------- */
  // A separate mini-game from the multiple-choice question bank above: 5 money
  // word problems per round, solved by typing the column-addition working
  // (answer digit + any carries) into a grid built fresh for each question's
  // own number of columns. Scoring and the shared leaderboard are reused via
  // the same `leaderboard` array (tagged category:'addition'), but the
  // moment-to-moment interaction (typed grid, live per-digit validation,
  // read-aloud, runner/rocket track) is entirely its own.
  // level: "easy" rounds mostly use amounts ending in 0 or 5 (few or no
  // carries), "medium" mixes in more varied endings with some carrying,
  // and "hard" uses fully varied 1-9 unit digits across more addends —
  // aaPickQuestions() below draws from these tiers in order so a round
  // eases a child in before the arithmetic gets trickier.
  const ADDITION_QUESTIONS = [
    { level: "easy", story: "Amy spent 20p on a sticker and 15p on a sweet. How much did she spend in total?", addends: [20,15] },
    { level: "easy", story: "Tom bought a pencil for 30p and a rubber for 25p. How much did he spend altogether?", addends: [30,25] },
    { level: "easy", story: "Mia saved 50p on Monday and 35p on Tuesday. How much had she saved in total?", addends: [50,35] },
    { level: "easy", story: "Jack bought a comic for 45p and a sticker book for 40p. How much did he spend in total?", addends: [45,40] },
