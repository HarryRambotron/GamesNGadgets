  /* ---------------- NEAR-DUPLICATE NAME DETECTION ---------------- */
  // A misspelling or a stray key press ("Alexx", "Alwx", "Jayde " ) should
  // not silently spawn a brand-new pilot with its own empty history. This
  // finds an existing name that's a plausible typo of what was just typed,
  // so the app can offer to reuse it instead of quietly forking a duplicate.
  function editDistance(a, b){
    // Optimal string alignment distance: insert/delete/substitute plus
    // adjacent-letter transposition as a single edit, since swapping two
    // neighbouring letters ("Riely" for "Riley") is a very common typo.
    const m = a.length, n = b.length;
    const dp = Array.from({length: m + 1}, () => new Array(n + 1).fill(0));
    for(let i = 0; i <= m; i++) dp[i][0] = i;
    for(let j = 0; j <= n; j++) dp[0][j] = j;
    for(let i = 1; i <= m; i++){
      for(let j = 1; j <= n; j++){
        const cost = a[i-1] === b[j-1] ? 0 : 1;
        dp[i][j] = Math.min(dp[i-1][j] + 1, dp[i][j-1] + 1, dp[i-1][j-1] + cost);
        if(i > 1 && j > 1 && a[i-1] === b[j-2] && a[i-2] === b[j-1]){
          dp[i][j] = Math.min(dp[i][j], dp[i-2][j-2] + 1);
        }
      }
    }
    return dp[m][n];
  }
  function findNearDuplicate(typedName){
    const key = playerKey(typedName);
    if(!key || key.length < 3 || players[key]) return null; // exact match is fine, not a duplicate risk
    let best = null;
    Object.keys(players).forEach(k => {
      if(k.length < 3) return;
      if(k[0] !== key[0]) return; // typos rarely change the very first letter
      if(Math.abs(k.length - key.length) > 2) return;
      const maxLen = Math.max(k.length, key.length);
      const threshold = maxLen <= 5 ? 1 : (maxLen <= 9 ? 2 : 3);
      const dist = editDistance(key, k);
      if(dist > 0 && dist <= threshold){
        if(!best || dist < best.dist) best = { name: players[k].name, dist: dist };
      }
    });
    return best;
  }
