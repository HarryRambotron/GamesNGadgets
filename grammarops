  const AA_COLUMN_LABELS = { 0:'1p', 1:'10p', 2:'£1s', 3:'£10s', 4:'£100s' };
  const AA_COLUMN_INFO = {
    0:'Ones of pence. Each digit here is worth 1p.',
    1:'Tens of pence. Each digit here is worth 10p.',
    2:'Ones of pounds. Each digit here is worth £1.',
    3:'Tens of pounds. Each digit here is worth £10.',
    4:'Hundreds of pounds. Each digit here is worth £100.'
  };
  const AA_WAYPOINTS = [23, 42, 61, 80, 95]; // runner's left% after finishing question index 0..4

  let aaQueue = [];
  let aaIndex = 0;
  let aaScore = 0;
  let aaResults = []; // {perfect, timeMs} per completed question
  let aaCurrentQuestion = null;
  let aaColumns = null; // {numColumns, numAddends, columns:[{place,label,info,addendDigits,answerDigit,carryIn}]}
  let aaFocusOrder = [];
  let aaFocusPos = 0;
  let aaMistakesThisQ = 0;
  let aaQuestionStartTime = 0;

  // Builds the column-by-column working for one question via the standard
  // right-to-left addition algorithm, so the answer digit and carry for
  // every column fall straight out of the simulation rather than being
  // hand-derived — correct by construction for any addend list.
  function aaBuildColumns(addends, total){
    const numColumns = Math.max(2, String(total).length);
    const cols = [];
    let carry = 0;
    for(let i = 0; i < numColumns; i++){
      const place = Math.pow(10, i);
      const addendDigits = addends.map(v => {
        if(i <= 2) return Math.floor(v / place) % 10; // pence + ones-of-pounds always shown
        return v >= place ? (Math.floor(v / place) % 10) : null; // blank beyond this addend's own size
      });
      const carryIn = carry;
      const colSum = carryIn + addendDigits.reduce((s,d) => s + (d === null ? 0 : d), 0);
      const answerDigit = colSum % 10;
      cols.push({
        place: i,
        label: AA_COLUMN_LABELS[i] || ('10^' + i),
        info: AA_COLUMN_INFO[i] || '',
        addendDigits: addendDigits,
        answerDigit: answerDigit,
        carryIn: i === 0 ? 0 : carryIn
      });
      carry = Math.floor(colSum / 10);
    }
    return { numColumns: numColumns, numAddends: addends.length, columns: cols };
  }

  function aaUpdateScoreDisplay(){
    el('aa-score-value').textContent = aaScore;
  }

  function aaRenderGrid(){
    const grid = el('aa-grid');
    grid.innerHTML = '';
    const numColumns = aaColumns.numColumns;
    const numAddends = aaColumns.numAddends;
    const penceOnly = aaCurrentQuestion.total < 100; // under £1 -> label the answer "...p" instead of "£..."
    // Rows: header, one per addend, a straight rule bar, the answer row,
    // another rule bar (the "write your answer here" underline), then carries.
    const totalRows = 5 + numAddends;

    // Left-to-right display order: a narrow "+" column first, then each
    // place-value column from most to least significant (with a decimal
    // point inserted right before the 10p column), and finally a narrow
    // trailing column that only ever holds the "p" unit label.
    const order = [];
    for(let i = numColumns - 1; i >= 0; i--) order.push(i);
    const displayCols = [{ type: 'label' }];
    let decimalInserted = false;
    order.forEach(i => {
      // A pence-only total (e.g. "55p") has no pounds column to separate
      // from, so it gets no decimal point at all — only an amount of £1 or
      // more needs one, inserted right before the 10p column.
      if(i === 1 && !decimalInserted && !penceOnly){ displayCols.push({ type: 'decimal' }); decimalInserted = true; }
      displayCols.push({ type: 'digit', place: i });
    });
    displayCols.push({ type: 'unit' });

    // Fixed widths (not a flexible 1fr) so a question with only a couple of
    // columns doesn't stretch them apart to fill the panel — the digits
    // stay close together, about a centimetre apart, however many columns
    // a question has, and the wrapper centers the resulting fixed-width grid.
    grid.style.gridTemplateColumns = displayCols.map(c =>
      c.type === 'label' ? '36px' : c.type === 'decimal' ? '14px' : c.type === 'unit' ? '22px' : '36px'
    ).join(' ');
    grid.style.gridTemplateRows = 'repeat(' + totalRows + ', auto)';

    function place(node, row, colIdx){
      node.style.gridRow = String(row);
      node.style.gridColumn = String(colIdx + 1);
      grid.appendChild(node);
    }

    const rowHeader = 1;
    const ruleRowTop = 2 + numAddends;
    const rowAnswer = 3 + numAddends;
    const ruleRowBottom = 4 + numAddends;
    const rowCarry = 5 + numAddends;

    // The two rule bars each span every column in one unbroken element,
    // rather than a border per cell (which the column gaps would chop up
    // into a dashed-looking line).
    const topBar = document.createElement('div');
    topBar.className = 'aa-rule-bar';
    place(topBar, ruleRowTop, 0);
    topBar.style.gridColumn = '1 / -1';
    const bottomBar = document.createElement('div');
    bottomBar.className = 'aa-rule-bar';
    place(bottomBar, ruleRowBottom, 0);
    bottomBar.style.gridColumn = '1 / -1';

    displayCols.forEach((dc, colIdx) => {
      const headerCell = document.createElement('div');
      if(dc.type === 'digit'){
        const colData = aaColumns.columns[dc.place];
        headerCell.className = 'aa-col-head';
        headerCell.innerHTML = '<span class="aa-col-head-label">' + escapeHtml(colData.label) + '</span>' +
          '<button type="button" class="aa-col-info-btn" data-place="' + dc.place + '" aria-label="What is this column worth?">ⓘ</button>' +
          '<div class="aa-col-info-pop" id="aa-col-info-' + dc.place + '">' + escapeHtml(colData.info) + '</div>';
      }
      place(headerCell, rowHeader, colIdx);

      for(let a = 0; a < numAddends; a++){
        const cell = document.createElement('div');
        if(dc.type === 'label'){
          cell.className = 'aa-plus-sign';
          cell.textContent = (a === numAddends - 1) ? '+' : '';
        } else if(dc.type === 'decimal'){
          cell.className = 'aa-decimal';
          cell.textContent = '.';
        } else if(dc.type === 'unit'){
          cell.className = 'aa-unit-sign';
        } else {
          // Step 1: the addend digits start blank — the child reads them
          // from the question above and types them in themselves, rather
          // than having the numbers already filled in for them.
          const d = aaColumns.columns[dc.place].addendDigits[a];
          if(d === null){
            cell.className = 'aa-digit';
          } else {
            const input = document.createElement('input');
            input.type = 'text';
            input.inputMode = 'numeric';
            input.autocomplete = 'off';
            input.maxLength = 1;
            input.className = 'aa-cell';
            input.dataset.kind = 'addend';
            input.dataset.addend = String(a);
            input.dataset.place = String(dc.place);
            input.setAttribute('aria-label', 'addend ' + (a + 1) + ' ' + (aaColumns.columns[dc.place] ? aaColumns.columns[dc.place].label : '') + ' digit');
            cell.appendChild(input);
          }
        }
        place(cell, 2 + a, colIdx);
      }

      const ansCell = document.createElement('div');
      if(dc.type === 'label'){
        ansCell.className = 'aa-plus-sign';
        ansCell.textContent = penceOnly ? '' : '£';
      } else if(dc.type === 'decimal'){
        ansCell.className = 'aa-decimal';
        ansCell.textContent = '.';
      } else if(dc.type === 'unit'){
        ansCell.className = 'aa-unit-sign';
        ansCell.textContent = penceOnly ? 'p' : '';
      } else {
        const input = document.createElement('input');
        input.type = 'text';
        input.inputMode = 'numeric';
        input.autocomplete = 'off';
        input.maxLength = 1;
        input.className = 'aa-cell';
        input.dataset.kind = 'answer';
        input.dataset.place = String(dc.place);
        input.setAttribute('aria-label', (aaColumns.columns[dc.place] ? aaColumns.columns[dc.place].label : '') + ' answer digit');
        input.disabled = true; // unlocked once every addend digit above has been typed in
        ansCell.appendChild(input);
      }
      place(ansCell, rowAnswer, colIdx);

      const carryCell = document.createElement('div');
      if(dc.type === 'digit'){
        const colData = aaColumns.columns[dc.place];
        if(dc.place === 0){
          // nothing carries into the rightmost (ones of pence) column
        } else if(colData.carryIn > 0){
          const input = document.createElement('input');
          input.type = 'text';
          input.inputMode = 'numeric';
          input.autocomplete = 'off';
          input.maxLength = 1;
          input.className = 'aa-cell aa-carry-cell';
          input.dataset.kind = 'carry';
          input.dataset.place = String(dc.place);
          input.setAttribute('aria-label', 'carry into ' + colData.label);
          input.disabled = true; // unlocked once every addend digit above has been typed in
          carryCell.appendChild(input);
        } else {
          carryCell.innerHTML = '<div class="aa-carry-dash">–</div>';
        }
      }
      place(carryCell, rowCarry, colIdx);
    });
  }

  function aaUpdateFocusOrder(){
    const grid = el('aa-grid');
    aaFocusOrder = [];
    // Step 1: the child types in each addend first, one row at a time,
    // reading left to right (most significant digit first) just like
    // reading the number itself — only the digits that actually exist for
    // that addend get a box.
    for(let a = 0; a < aaColumns.numAddends; a++){
      for(let i = aaColumns.numColumns - 1; i >= 0; i--){
        const addendEl = grid.querySelector('.aa-cell[data-kind="addend"][data-addend="' + a + '"][data-place="' + i + '"]');
        if(addendEl) aaFocusOrder.push(addendEl);
      }
    }
    // Step 2: then work out the sum itself, right-to-left with carries —
    // these boxes stay locked (see aaRenderGrid) until step 1 is done.
    const ans0 = grid.querySelector('.aa-cell[data-kind="answer"][data-place="0"]');
    if(ans0) aaFocusOrder.push(ans0);
    for(let i = 1; i < aaColumns.numColumns; i++){
      const carryEl = grid.querySelector('.aa-cell[data-kind="carry"][data-place="' + i + '"]');
      if(carryEl) aaFocusOrder.push(carryEl);
      const ansEl = grid.querySelector('.aa-cell[data-kind="answer"][data-place="' + i + '"]');
      if(ansEl) aaFocusOrder.push(ansEl);
    }
    aaFocusPos = 0;
  }

  // Unlocks every answer/carry box at once, the moment the last addend
  // digit has been typed in correctly — they start disabled (see
  // aaRenderGrid) so the child can't jump ahead to the sum before they've
  // copied the numbers themselves into the addend rows.
  function aaUnlockAnswerCells(){
    const grid = el('aa-grid');
    grid.querySelectorAll('.aa-cell[data-kind="answer"], .aa-cell[data-kind="carry"]').forEach(inp => {
      inp.disabled = false;
    });
  }

  function aaFocusCurrent(){
    if(aaFocusPos >= aaFocusOrder.length) return;
    const target = aaFocusOrder[aaFocusPos];
    // Focusing right after a screen is unhidden or the grid is rebuilt can
    // occasionally be swallowed before the browser finishes layout, so this
    // retries on the next couple of animation frames as a robustness net —
    // the goal is the answer box is always ready to type into without a click.
    target.focus();
    requestAnimationFrame(() => {
      if(document.activeElement !== target) target.focus();
      requestAnimationFrame(() => {
        if(document.activeElement !== target) target.focus();
      });
    });
  }

  function aaHandleCellInput(e){
    const input = e.target;
    if(!input.classList || !input.classList.contains('aa-cell')) return;
    const raw = input.value.replace(/[^0-9]/g, '').slice(0, 1);
    input.value = raw;
    if(raw === ''){ input.classList.remove('aa-wrong'); return; }
    const place = parseInt(input.dataset.place, 10);
    const kind = input.dataset.kind;
    const colData = aaColumns.columns[place];
    const correctDigit = kind === 'answer' ? colData.answerDigit
      : kind === 'carry' ? colData.carryIn
      : colData.addendDigits[parseInt(input.dataset.addend, 10)];
    if(parseInt(raw, 10) === correctDigit){
      input.classList.remove('aa-wrong');
      input.classList.add('aa-correct');
      input.disabled = true;
      aaFocusPos++;
      if(aaFocusPos < aaFocusOrder.length){
        const next = aaFocusOrder[aaFocusPos];
        if(kind === 'addend' && next.dataset.kind !== 'addend'){
          aaUnlockAnswerCells(); // just finished the last addend digit — the sum is now fair game
        }
        next.focus();
      } else {
        aaCompleteQuestion();
      }
    } else {
      input.classList.remove('aa-correct');
      input.classList.add('aa-wrong');
      aaMistakesThisQ++;
      try{ playGentleWrong(); }catch(e2){}
      setTimeout(() => { input.select(); }, 10);
    }
  }

  function aaSpeakText(text){
    if(!window.speechSynthesis) return;
    try{
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(text);
      utter.rate = 0.92;
      utter.pitch = 1.0;
      window.speechSynthesis.speak(utter);
    }catch(e){ /* speech synthesis not available — the button is disabled below in that case */ }
  }

  function aaLoadQuestion(idx){
    aaCurrentQuestion = aaQueue[idx];
    const total = aaCurrentQuestion.addends.reduce((s, v) => s + v, 0);
    aaCurrentQuestion.total = total;
    aaColumns = aaBuildColumns(aaCurrentQuestion.addends, total);
    aaMistakesThisQ = 0;
    aaQuestionStartTime = Date.now();
    el('aa-qcount').textContent = 'Question ' + (idx + 1) + ' of ' + aaQueue.length;
    el('aa-story').textContent = aaCurrentQuestion.story;
    el('aa-feedback').textContent = '';
    aaRenderGrid();
    aaUpdateFocusOrder();
    aaFocusCurrent();
  }

  function aaCompleteQuestion(){
    const timeMs = Date.now() - aaQuestionStartTime;
    const perfect = aaMistakesThisQ === 0;
    const basePoints = 15;
    const bonus = perfect ? 10 : 0;
    aaScore += basePoints + bonus;
    aaResults.push({ perfect: perfect, timeMs: timeMs });
    aaUpdateScoreDisplay();
    el('aa-feedback').textContent = perfect
      ? '🌟 Perfect column addition! +' + (basePoints + bonus) + ' points'
      : '✅ Solved it! +' + basePoints + ' points';
    try{ playCorrect(); }catch(e){}
    aaAdvanceRunner();
  }

  function aaAdvanceRunner(){
    const runner = el('aa-runner');
    const target = AA_WAYPOINTS[aaIndex];
    runner.classList.add('jump');
    runner.style.left = target + '%';
    setTimeout(() => {
      runner.classList.remove('jump');
      aaIndex++;
      if(aaIndex < aaQueue.length){
        aaLoadQuestion(aaIndex);
      } else {
        aaLaunchRocket();
      }
    }, 750);
  }

  function aaLaunchRocket(){
    el('aa-runner').classList.add('hidden'); // the pilot boards the rocket
    el('aa-track').classList.add('launching'); // lets the rocket climb clear of the track's clipped box
    const rocket = el('aa-rocket');
    rocket.classList.add('launch');
    try{ playFinishTune(); }catch(e){}
    setTimeout(() => { aaEndMission(); }, 2000);
  }

  function aaEndMission(){
    const total = aaResults.length;
    const perfectCount = aaResults.filter(r => r.perfect).length;
    const accuracy = total ? Math.round((perfectCount / total) * 100) : 0;
    const avgMs = total ? aaResults.reduce((s, r) => s + r.timeMs, 0) / total : 0;

    el('res-correct').textContent = perfectCount + ' / ' + total;
    el('res-accuracy').textContent = accuracy + '%';
    el('res-avgtime').textContent = (avgMs / 1000).toFixed(1) + 's';
    el('res-distance-stat').classList.add('hidden');

    let msg = 'Great effort!';
    if(accuracy >= 90) msg = '🌟 Outstanding — top marks!';
    else if(accuracy >= 75) msg = '💪 Really strong work!';
    else if(accuracy >= 50) msg = '👍 Good progress — keep practising!';
    else msg = '🔧 Nice try — let’s review a few together.';
    el('results-message').textContent = msg;

    leaderboard.push({
      name: playerName,
      score: aaScore,
      correct: perfectCount,
      total: total,
      accuracy: accuracy,
      avgMs: avgMs,
      category: 'addition',
      ts: Date.now()
    });
    saveLeaderboard();

    const player = getOrCreatePlayer(playerName);
    if(player){ player.gamesPlayed = (player.gamesPlayed || 0) + 1; savePlayers(); }
    renderPilotDatalist();

    el('same-name-label').textContent = playerName;
    el('new-name-field').classList.add('hidden');
    el('new-name-confirm-row').classList.add('hidden');
    el('new-name-input').value = '';
    el('new-name-recognition').textContent = '';

    el('btn-review').classList.add('hidden'); // the review screen isn't shaped for addition rounds

    showScreen(screenResults);
  }

  // Builds one round's 5 questions as 2 easy + 2 medium + 1 hard, each tier
  // shuffled independently and kept in that order, so every run through
  // starts with gentler amounts (ending in 0 or 5) and eases into more
  // varied unit digits — while which specific questions appear still
  // varies session to session.
  function aaPickQuestions(){
    const byLevel = { easy: [], medium: [], hard: [] };
    ADDITION_QUESTIONS.forEach(q => { (byLevel[q.level] || byLevel.easy).push(q); });
    return shuffle(byLevel.easy).slice(0, 2)
      .concat(shuffle(byLevel.medium).slice(0, 2))
      .concat(shuffle(byLevel.hard).slice(0, 1));
  }

  function startAdditionAlley(){
    aaScore = 0;
    aaResults = [];
    aaIndex = 0;
    aaQueue = aaPickQuestions();
    const icon = saveIconForCurrentPlayer();
    el('aa-hud-player-name').textContent = icon + ' ' + playerName;
    aaUpdateScoreDisplay();
    const runner = el('aa-runner');
    runner.classList.remove('hidden');
    runner.classList.remove('jump');
    runner.style.left = '2%';
    el('aa-rocket').classList.remove('launch');
    el('aa-track').classList.remove('launching');
    showScreen(screenAddition);
    aaLoadQuestion(0);
  }

  el('aa-grid').addEventListener('input', aaHandleCellInput);
  el('aa-grid').addEventListener('click', (e) => {
    const btn = e.target.closest('.aa-col-info-btn');
    if(!btn) return;
    const pop = el('aa-col-info-' + btn.dataset.place);
    if(pop) pop.classList.toggle('show');
  });
  document.addEventListener('click', (e) => {
    if(!e.target.closest('.aa-col-head')){
      document.querySelectorAll('.aa-col-info-pop.show').forEach(p => p.classList.remove('show'));
    }
  });
  el('aa-speak-btn').addEventListener('click', () => {
    if(aaCurrentQuestion) aaSpeakText(aaCurrentQuestion.story);
  });
  if(!window.speechSynthesis){
    el('aa-speak-btn').disabled = true;
    el('aa-speak-btn').title = 'Read-aloud is not supported in this browser';
  }
  el('btn-aa-exit').addEventListener('click', () => {
    if(window.speechSynthesis) window.speechSynthesis.cancel();
    showScreen(screenCategory);
  });

  /* ---------------- LEADERBOARD ---------------- */
  function renderLeaderboardTabs(){
    const tabsEl = el('lb-tabs');
    tabsEl.innerHTML = LEADERBOARD_TABS.map(tab =>
      '<button type="button" class="lb-tab' + (tab === leaderboardFilter ? ' active' : '') + '" data-tab="' + tab + '">' +
        leaderboardTabLabel(tab) +
      '</button>'
    ).join('');
  }

  function renderLeaderboard(){
    renderLeaderboardTabs();
    const content = el('leaderboard-content');
    const note = el('storage-note');
    note.textContent = storageAvailable
      ? ''
      : "Note: this browser is blocking saved data, so the scoreboard won't be remembered next time.";
    // "Overall" shows every game ever played (including older saved rows
    // from before per-subject scoreboards existed, which have no category).
    // Every other tab shows only games played in that specific subject.
    const rows = leaderboardFilter === 'overall'
      ? leaderboard
      : leaderboard.filter(row => row.category === leaderboardFilter);
    if(rows.length === 0){
      const label = leaderboardTabLabel(leaderboardFilter);
      content.innerHTML = '<div class="lb-empty">' +
        (leaderboardFilter === 'overall'
          ? 'No missions completed yet — play a round!'
          : 'No ' + label + ' missions completed yet — play a round!') +
        '</div>';
      return;
    }
    // Personal-best scoreboard: one row per pilot, showing only their
    // highest-ever score (within the selected subject) rather than every
    // game they've ever played.
    const bestByPlayer = {};
    rows.forEach(row => {
      const key = playerKey(row.name);
      if(!bestByPlayer[key] || row.score > bestByPlayer[key].score){
        bestByPlayer[key] = row;
      }
    });
    const sorted = Object.values(bestByPlayer).sort((a,b) => b.score - a.score);
    const myKey = playerKey(playerName);
    let html = '<table class="lb-table"><thead><tr>' +
      '<th>#</th><th></th><th>Pilot</th><th>Best score</th><th>Accuracy</th><th>Avg time</th>' +
      '</tr></thead><tbody>';
    sorted.forEach((row, i) => {
      const medal = i === 0 ? '🥇' : (i === 1 ? '🥈' : (i === 2 ? '🥉' : (i+1)));
      const isMe = playerKey(row.name) === myKey;
      html += '<tr class="' + (isMe ? 'me' : '') + '">' +
        '<td class="lb-rank">' + medal + '</td>' +
        '<td class="lb-icon">' + iconForName(row.name) + '</td>' +
        '<td class="lb-name">' + escapeHtml(row.name) + '</td>' +
        '<td>' + row.score + '</td>' +
        '<td>' + row.accuracy + '%</td>' +
        '<td>' + (row.avgMs/1000).toFixed(1) + 's</td>' +
        '</tr>';
    });
    html += '</tbody></table>';
    content.innerHTML = html;
  }

  /* ---------------- REVIEW SCREEN ---------------- */
  function openReview(){
    const wrongOnes = answered.filter(a => !a.isCorrect);
    const list = el('review-list');
    list.innerHTML = '';
    if(wrongOnes.length === 0){
      list.innerHTML = '<div class="lb-empty">No mistakes to review — perfect run!</div>';
    }
    wrongOnes.forEach(a => {
      const row = document.createElement('div');
      row.className = 'review-row';
      row.innerHTML =
        '<div class="rtype">' + a.type + '</div>' +
        '<div class="rsentence">' + renderSentence(a, true) + '</div>' +
        '<div class="rmeta">You chose <b>' + escapeHtml(a.chosen) + '</b> — correct answer: <b class="ok">' + escapeHtml(a.correct) + '</b></div>' +
        '<div class="rwhy"><span class="rwhy-label">Why:</span>' + escapeHtml(explainAnswer(a)) + '</div>';
      list.appendChild(row);
    });
    showScreen(screenReview);
  }

  /* ---------------- CORRECTIONS SCREEN ---------------- */
  function renderCorrections(){
    const key = playerKey(playerName || 'Player');
    const player = players[key] || { name: (playerName || 'Player').trim(), mistakes: {} };
    el('corrections-player-name').textContent = player.name;
    const list = el('corrections-list');
    const items = Object.values(player.mistakes).sort((a,b) => b.timesWrong - a.timesWrong);
    if(items.length === 0){
      list.innerHTML = '<div class="lb-empty">No mistakes recorded yet for this pilot — keep flying!</div>';
      return;
    }
    list.innerHTML = items.map(item => {
      const why = explainAnswer(Object.assign({}, item, { chosen: item.lastChosen }));
      return '<div class="review-row">' +
        '<div class="rtype">' + item.type + ' — missed ' + item.timesWrong + (item.timesWrong === 1 ? ' time' : ' times') + '</div>' +
        '<div class="rsentence">' + renderSentence(item, true) + '</div>' +
        '<div class="rmeta">Correct answer: <b class="ok">' + escapeHtml(item.correct) + '</b></div>' +
        '<div class="rwhy"><span class="rwhy-label">Why:</span>' + escapeHtml(why) + '</div>' +
        '</div>';
    }).join('');
  }

  /* ---------------- EVENTS ---------------- */
  buildAlphabetStrip();
  el('ab-row').addEventListener('mouseover', (e) => {
    const t = e.target.closest('.ab-letter');
    if(t) abHandleHoverIn(parseInt(t.dataset.i, 10));
  });
  el('ab-row').addEventListener('mouseout', (e) => {
    const t = e.target.closest('.ab-letter');
    if(t) abHandleHoverOut(parseInt(t.dataset.i, 10));
  });
  el('ab-row').addEventListener('click', (e) => {
    const t = e.target.closest('.ab-letter');
    if(t) abHandleClick(parseInt(t.dataset.i, 10));
  });
  el('btn-ab-clear').addEventListener('click', clearAlphabetAnnotations);

  document.querySelectorAll('.mission-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedCategory = btn.dataset.category;
      selectedTypes = CATEGORY_TYPES[selectedCategory];
      el('mission-name').textContent = CATEGORY_LABELS[selectedCategory];
      if(playerName){ el('name-input').value = playerName; }
      updateNameRecognition('name-input', 'name-recognition');
      iconOverride = null;
      refreshIconPreview('start');
      const isAddition = selectedCategory === 'addition';
      el('start-rules-standard').classList.toggle('hidden', isAddition);
      el('start-rules-addition').classList.toggle('hidden', !isAddition);
      el('mode-toggle-row').classList.toggle('hidden', isAddition);
      el('btn-view-example').classList.toggle('hidden', isAddition);
      showScreen(screenStart);
    });
  });

  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      gameMode = btn.dataset.mode;
      document.querySelectorAll('.mode-btn').forEach(b => b.classList.toggle('selected', b === btn));
    });
  });

  el('btn-change-mission').addEventListener('click', () => {
    showScreen(screenCategory);
  });

  el('btn-view-example').addEventListener('click', () => {
    showExampleModal(selectedCategory);
  });
  el('btn-example-close').addEventListener('click', () => {
    el('example-modal-backdrop').classList.add('hidden');
  });
  el('example-modal-backdrop').addEventListener('click', (e) => {
    if(e.target.id === 'example-modal-backdrop') el('example-modal-backdrop').classList.add('hidden');
  });

  el('btn-category-leaderboard').addEventListener('click', () => {
    leaderboardReturnScreen = screenCategory;
    renderLeaderboard();
    showScreen(screenLeaderboard);
  });

  function startSelectedMission(){
    if(selectedCategory === 'addition') startAdditionAlley();
    else startGame();
  }

  el('btn-start').addEventListener('click', () => {
    const nameVal = el('name-input').value.trim();
    playerName = resolveName(nameVal || 'Player');
    el('name-input').value = playerName;
    ctx(); // unlock audio on user gesture
    startSelectedMission();
  });

  el('name-input').addEventListener('keydown', (e) => {
    if(e.key === 'Enter') el('btn-start').click();
  });
  el('name-input').addEventListener('input', () => {
    updateNameRecognition('name-input', 'name-recognition');
    refreshIconPreview('start');
  });

  el('btn-start-corrections').addEventListener('click', () => {
    const nameVal = el('name-input').value.trim() || playerName || 'Player';
    playerName = resolveName(nameVal);
    el('name-input').value = playerName;
    correctionsReturnScreen = screenStart;
    renderCorrections();
    showScreen(screenCorrections);
  });

  document.addEventListener('click', (e) => {
    const link = e.target.closest('.name-suggestion');
    if(!link) return;
    e.preventDefault();
    const targetInput = el(link.dataset.target);
    if(!targetInput) return;
    targetInput.value = link.dataset.name;
    const boxId = link.dataset.target === 'name-input' ? 'name-recognition' : 'new-name-recognition';
    updateNameRecognition(link.dataset.target, boxId);
  });

  el('btn-same-name').addEventListener('click', () => {
    startSelectedMission();
  });

  el('btn-new-name').addEventListener('click', () => {
    el('new-name-field').classList.remove('hidden');
    el('new-name-confirm-row').classList.remove('hidden');
    el('new-name-input').value = '';
    el('new-name-recognition').textContent = '';
    iconOverride = null;
    refreshIconPreview('new');
    el('new-name-input').focus();
  });

  el('new-name-input').addEventListener('keydown', (e) => {
    if(e.key === 'Enter') el('btn-confirm-new-name').click();
  });
  el('new-name-input').addEventListener('input', () => {
    updateNameRecognition('new-name-input', 'new-name-recognition');
    refreshIconPreview('new');
  });

  el('btn-confirm-new-name').addEventListener('click', () => {
    const val = el('new-name-input').value.trim();
    playerName = resolveName(val || 'Player');
    el('new-name-input').value = playerName;
    startSelectedMission();
  });

  let leaderboardReturnScreen = screenStart;
  el('btn-leaderboard').addEventListener('click', () => {
    leaderboardReturnScreen = screenResults;
    renderLeaderboard();
    showScreen(screenLeaderboard);
  });
  el('btn-start-leaderboard').addEventListener('click', () => {
    leaderboardReturnScreen = screenStart;
    renderLeaderboard();
    showScreen(screenLeaderboard);
  });
  el('btn-leaderboard-back').addEventListener('click', () => showScreen(leaderboardReturnScreen));
  el('lb-tabs').addEventListener('click', (e) => {
    const btn = e.target.closest('.lb-tab');
    if(!btn) return;
    leaderboardFilter = btn.dataset.tab;
    renderLeaderboard();
  });
  el('btn-clear-leaderboard').addEventListener('click', () => {
    const scoped = leaderboardFilter !== 'overall';
    const msg = scoped
      ? 'Clear the ' + leaderboardTabLabel(leaderboardFilter) + ' scoreboard? This cannot be undone.'
      : 'Clear the whole scoreboard? This cannot be undone.';
    if(window.confirm(msg)){
      leaderboard = scoped
        ? leaderboard.filter(row => row.category !== leaderboardFilter)
        : [];
      saveLeaderboard();
      renderLeaderboard();
    }
  });

  el('btn-review').addEventListener('click', () => {
    openReview();
  });
  el('btn-review-back').addEventListener('click', () => showScreen(screenResults));

  el('btn-main-menu').addEventListener('click', () => {
    showScreen(screenCategory);
  });

  let correctionsReturnScreen = screenResults;
  el('btn-corrections').addEventListener('click', () => {
    correctionsReturnScreen = screenResults;
    renderCorrections();
    showScreen(screenCorrections);
  });
  el('btn-corrections-back').addEventListener('click', () => showScreen(correctionsReturnScreen));
  el('btn-clear-corrections').addEventListener('click', () => {
    const player = getOrCreatePlayer(playerName);
    if(player && window.confirm('Clear all saved corrections for ' + player.name + '? This cannot be undone.')){
      player.mistakes = {};
      savePlayers();
      renderCorrections();
    }
  });

  function renderInfoModal(){
    const counts = {};
    QUESTIONS.forEach(q => { counts[q.type] = (counts[q.type] || 0) + 1; });
    const total = QUESTIONS.length;
    const grammarCount = (counts.determiner || 0) + (counts.preposition || 0);
    const spellingCount = (counts.spelling || 0) + (counts.punctuation || 0);
    const synCount = (counts.synonym || 0) + (counts.antonym || 0);
    const vocabCount = counts.vocabulary || 0;
    const compoundCount = counts.compound || 0;
    const letterpairCount = counts.letterpair || 0;
    el('info-modal-content').innerHTML =
      '<p>This game currently has <b style="color:var(--accent-yellow);">' + total + '</b> questions in total, drawn from widely-used 11+ (GL Assessment) vocabulary and spelling word lists.</p>' +
      '<p>🔤 <b>Prepositions &amp; Determiners:</b> ' + grammarCount + ' questions (' + (counts.determiner || 0) + ' determiner, ' + (counts.preposition || 0) + ' preposition)</p>' +
      '<p>✏️ <b>Spelling &amp; Punctuation:</b> ' + spellingCount + ' questions (' + (counts.spelling || 0) + ' spelling, ' + (counts.punctuation || 0) + ' punctuation — apostrophes, plus GL Assessment-style "spot the mistake" passages covering commas, capital letters and full stops)</p>' +
      '<p>🔁 <b>Synonyms &amp; Antonyms:</b> ' + synCount + ' questions (' + (counts.synonym || 0) + ' synonym, ' + (counts.antonym || 0) + ' antonym, across ' + (counts.synonym || 0) + ' unique words)</p>' +
      '<p>📚 <b>Vocabulary Meanings:</b> ' + vocabCount + ' questions, matching a definition to the correct word</p>' +
      '<p>🧩 <b>Compound Words:</b> ' + compoundCount + ' questions, joining two words into one real word</p>' +
      '<p>🔗 <b>Letter Pair Puzzles:</b> ' + letterpairCount + ' questions, cracking the rule that links a pair of letters — alphabet shifts, and trickier mirror reflections — GL Assessment "Letter Connections" style</p>' +
      '<p>🚀 <b>Addition Alley:</b> ' + ADDITION_QUESTIONS.length + ' column-addition money word problems (5 played per round), with read-aloud and a step-by-step carry walkthrough</p>';
  }
  el('btn-info').addEventListener('click', () => {
    renderInfoModal();
    el('info-modal-backdrop').classList.remove('hidden');
  });
  el('btn-info-close').addEventListener('click', () => {
    el('info-modal-backdrop').classList.add('hidden');
  });
  el('info-modal-backdrop').addEventListener('click', (e) => {
    if(e.target.id === 'info-modal-backdrop') el('info-modal-backdrop').classList.add('hidden');
  });

  /* ---------------- EXIT MISSION EARLY ---------------- */
  // Without this, a pilot who launched the wrong mission had no way back
  // to mission select except waiting out the full 5-minute game timer.
  el('btn-exit-mission').addEventListener('click', () => {
    el('exit-modal-backdrop').classList.remove('hidden');
  });
  el('btn-exit-cancel').addEventListener('click', () => {
    el('exit-modal-backdrop').classList.add('hidden');
  });
  el('exit-modal-backdrop').addEventListener('click', (e) => {
    if(e.target.id === 'exit-modal-backdrop') el('exit-modal-backdrop').classList.add('hidden');
  });
  el('btn-exit-confirm').addEventListener('click', () => {
    // Cancel any pending auto-advance from a just-answered correct question
    // so it can't fire after we've already navigated away.
    if(pendingNextTimeout !== null){
      clearTimeout(pendingNextTimeout);
      pendingNextTimeout = null;
    }
    stopSpeedTicker(); // Speed Round: don't let the bird keep falling off-screen
    resetPauseState(); // don't carry a paused HUD state into the next mission
    awaitingContinue = false;
    el('exit-modal-backdrop').classList.add('hidden');
    showScreen(screenCategory);
  });

  /* ---------------- PAUSE BUTTON WIRING ---------------- */
  el('btn-pause').addEventListener('click', togglePause);
  el('btn-resume').addEventListener('click', resumeGame);

  /* ---------------- TRACING PAPER WIRING ---------------- */
  el('btn-tracing-toggle').addEventListener('click', toggleTracingPaper);
  el('btn-tracing-close').addEventListener('click', closeTracingPaper);
  el('btn-tracing-clear').addEventListener('click', clearTracingCanvas);
  el('btn-tool-pencil').addEventListener('click', () => setTracingTool('pencil'));
  el('btn-tool-ruler').addEventListener('click', () => setTracingTool('ruler'));
  el('btn-tool-eraser').addEventListener('click', () => setTracingTool('eraser'));
  (function(){
    const canvas = el('tracing-canvas');
    canvas.addEventListener('pointerdown', tracingStart);
    canvas.addEventListener('pointermove', tracingMove);
    canvas.addEventListener('pointerup', tracingEnd);
    canvas.addEventListener('pointerleave', tracingEnd);
    canvas.addEventListener('pointercancel', tracingEnd);
  })();
  window.addEventListener('resize', () => {
    if(el('tracing-paper').classList.contains('open')) resizeTracingCanvas();
  });

  /* ---------------- ICON PICKER ---------------- */
  let iconModalTarget = 'start'; // 'start' or 'new' — which name field we're picking for
  renderIconGrid();
  el('btn-pick-icon-start').addEventListener('click', () => {
    iconModalTarget = 'start';
    el('icon-modal-backdrop').classList.remove('hidden');
  });
  el('btn-pick-icon-new').addEventListener('click', () => {
    iconModalTarget = 'new';
    el('icon-modal-backdrop').classList.remove('hidden');
  });
  el('btn-icon-cancel').addEventListener('click', () => {
    el('icon-modal-backdrop').classList.add('hidden');
  });
  el('icon-modal-backdrop').addEventListener('click', (e) => {
    if(e.target.id === 'icon-modal-backdrop'){
      el('icon-modal-backdrop').classList.add('hidden');
      return;
    }
    const btn = e.target.closest('button[data-icon]');
    if(btn){
      iconOverride = btn.getAttribute('data-icon');
      refreshIconPreview(iconModalTarget);
      el('icon-modal-backdrop').classList.add('hidden');
    }
  });

  renderPilotDatalist();

  document.addEventListener('keydown', (e) => {
    if(!screenGame.classList.contains('hidden')){
      if((e.key === 'p' || e.key === 'P') && !e.target.closest('input')){
        e.preventDefault();
        togglePause();
        return;
      }
      if(isPaused) return;
      if(awaitingContinue && e.code === 'Space'){
        e.preventDefault();
        handleContinue();
        return;
      }
      if(!awaitingContinue && ['1','2','3','4','5'].includes(e.key)){
        const idx = parseInt(e.key,10) - 1;
        if(idx < currentOptions.length) selectAnswer(idx);
      }
    }
  });

  screenGame.addEventListener('click', (e) => {
    if(isPaused) return;
    if(awaitingContinue && !e.target.closest('.opt-btn')){
      handleContinue();
    }
  });

})();
</script>
</body>
</html>
